# --- Languages, runtimes and tooling ---
brew "make"
brew "go"
brew "mise"
brew "python@3.14"
brew "pipx"
brew "rust"
brew "shellcheck"
brew "shfmt"
brew "bats-core"

# --- PHP and Composer ---
# php is the CLI default. Homebrew's php ships a base extension set, so the
# `php` install phase builds redis and imagick for every version present.
brew "php"
# Valet (`.test` sites with TLS) is not a brew package. Install it with
# `composer global require` after install.
brew "composer"

# --- CLI tools ---
brew "act"
brew "sshpass"

# --- IDEs and Editors ---
cask "visual-studio-code"
cask "phpstorm"

# --- Linters and formatters ---
brew "actionlint"
brew "swiftformat"

# --- Agents and terminal ---
brew "anomalyco/tap/opencode"
brew "pi-coding-agent"

cask "claude-code@latest"
cask "codex"
cask "t3-code"

# --- Services ---
cask "orbstack"
