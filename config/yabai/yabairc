#!/usr/bin/env sh

# Ensure helper commands resolve from Homebrew when yabai runs as a service.
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"

# =============================================================================
# yabai configuration — Catppuccin / gentleman style
#
# Works with SIP enabled; advanced
# features (window opacity, no shadow, instant move, focus follows mouse) need
# System Integrity Protection partially disabled:
#   https://github.com/koekeishiya/yabai/wiki/Disabling-System-Integrity-Protection
# The scripting-addition lines below are no-ops when SIP blocks them.
# =============================================================================

# Load the scripting addition (gracefully fails with SIP enabled).
yabai -m signal --add event=dock_did_restart action="sudo yabai --load-sa" 2>/dev/null
sudo yabai --load-sa 2>/dev/null

# -----------------------------------------------------------------------------
# Global layout
# -----------------------------------------------------------------------------
yabai -m config layout            bsp
yabai -m config top_padding       12
yabai -m config bottom_padding    12
yabai -m config left_padding      12
yabai -m config right_padding     12
yabai -m config window_gap        10
yabai -m config split_ratio       0.50
yabai -m config split_type        auto
yabai -m config auto_balance      on


# Mouse
yabai -m config mouse_follows_focus  on
yabai -m config focus_follows_mouse  off
yabai -m config mouse_modifier       fn
yabai -m config mouse_action1        move
yabai -m config mouse_action2        resize
yabai -m config mouse_drop_action    swap

# Extras
yabai -m config window_animation_duration 0.0
yabai -m config window_opacity_duration   0.2
yabai -m config insert_feedback_color     0xff61afef

# -----------------------------------------------------------------------------
# Window styling (Catppuccin macchiato)
# -----------------------------------------------------------------------------
yabai -m config window_opacity           on
yabai -m config active_window_opacity    1.0
yabai -m config normal_window_opacity    0.95
yabai -m config window_shadow            float

# -----------------------------------------------------------------------------
# Rules
# -----------------------------------------------------------------------------
yabai -m rule --add app="^System Settings$" manage=off
yabai -m rule --add app="^Calculator$" manage=off
yabai -m rule --add app="^Finder$" title="^$" manage=off
yabai -m rule --add app="^Spotify$" manage=off
yabai -m rule --add app="^Raycast$" manage=off
yabai -m rule --add app="^1Password" manage=off

# -----------------------------------------------------------------------------
# Space labels
# -----------------------------------------------------------------------------
yabai -m space 1 --label social       2>/dev/null || true
yabai -m space 2 --label work         2>/dev/null || true
yabai -m space 3 --label development  2>/dev/null || true
yabai -m space 4 --label browser      2>/dev/null || true
yabai -m space 5 --label other        2>/dev/null || true

# Ghostty native tabs surface as separate windows through macOS' Accessibility API,
# so yabai tiles each new tab and breaks the layout. Re-apply the bsp layout whenever
# a Ghostty window appears or disappears to re-normalise the space (official workaround).
yabai -m signal --add app='^Ghostty$' event=window_created action='yabai -m space --layout bsp'
yabai -m signal --add app='^Ghostty$' event=window_destroyed action='yabai -m space --layout bsp'

echo "yabai configuration loaded"

# JankyBorders
pgrep -q borders || "$HOME/.config/borders/bordersrc" &
