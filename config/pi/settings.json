{
  "autocompleteMaxVisible": 5,
  "defaultModel": "gpt-5.6-luna",
  "defaultProjectTrust": "always",
  "defaultProvider": "openai-codex",
  "defaultThinkingLevel": "high",
  "doubleEscapeAction": "none",
  "editorPaddingX": 1,
  "enableInstallTelemetry": false,
  "enabledModels": [
    "openai-codex/gpt-5.6-sol",
    "openai-codex/gpt-5.6-luna",
    "opencode/muse-spark-1.3-contributor-free",
    "anthropic/claude-opus-5",
    "anthropic/claude-sonnet-5"
  ],
  "followUpMode": "all",
  "fullscreenExitOutput": "resume-hint",
  "fullscreenScrollbar": "always",
  "hideThinkingBlock": false,
  "images": {
    "blockImages": false
  },
  "lastChangelogVersion": "0.85.1",
  "modelThinkingLevels": {
    "anthropic/claude-opus-5": "medium",
    "anthropic/claude-sonnet-5": "high",
    "openai-codex/gpt-5.6-luna": "xhigh",
    "openai-codex/gpt-5.6-sol": "high",
    "opencode-go/hy3": "high",
    "opencode/muse-spark-1.3-contributor-free": "xhigh",
    "openai-codex/gpt-6-astra": "high"
  },
  "outputPad": 1,
  "packages": [
    "npm:gentle-pi@2.5.0",
    "npm:gentle-engram",
    "npm:pi-intercom",
    "npm:pi-web-access",
    "npm:pi-lens",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:@zerosnow/pi-shimmer",
    "npm:gentle-engram@0.1.8",
    "npm:pi-btw",
    "npm:@gotgenes/pi-anthropic-auth",
    "npm:pi-workspace-history",
    "npm:pi-mcp-adapter",
    "git:github.com/Kilo-Org/kilo-pi-provider@v2026.08.0"
  ],
  "quietStartup": true,
  "showHardwareCursor": true,
  "steeringMode": "all",
  "terminal": {
    "showTerminalProgress": false,
    "imageWidthCells": 120
  },
  "theme": "dark",
  "transport": "auto",
  "treeFilterMode": "default",
  "tuiMode": "fullscreen",
  "warnings": {
    "anthropicExtraUsage": false
  },
  "showCacheMissNotices": true,
  "httpIdleTimeoutMs": 0,
  "markdown": {
    "mermaid": "streaming"
  },
  "collapseChangelog": true,
  "fullscreenCopyOnSelect": true
}