# ┌──────────────────────────────────────────────────────────────────────────────┐
# │                            Custom Ghostty config                             │
# │                  Custom Ghostty colors (Catppuccin Macchiato)                 │
# └──────────────────────────────────────────────────────────────────────────────┘

# ┌──────────────────────────────────────────────────────────────────────────────┐
# │                                  WINDOWS                                     │
# └──────────────────────────────────────────────────────────────────────────────┘

# --- Basic ---
maximize = true
fullscreen = non-native-visible-menu
window-save-state = always
background-opacity = 0.95
background-blur-radius = 30

# --- MACOS ---
macos-non-native-fullscreen = true
macos-window-buttons = hidden
macos-titlebar-style = hidden
macos-titlebar-proxy-icon = hidden
macos-dock-drop-behavior = window
macos-option-as-alt = left

# --- Windows ---
window-decoration = none
window-padding-color = extend
window-step-resize = false
window-padding-balance = true
window-height = 100
window-width = 100
window-theme = system
window-colorspace = display-p3

# --- Splits ---
unfocused-split-opacity = 0.3

# ┌──────────────────────────────────────────────────────────────────────────────┐
# │                            INPUT / KEYBINDINGS                               │
# └──────────────────────────────────────────────────────────────────────────────┘

selection-word-chars = " /\t'\"│`|:,()[]{}<>$"

# --- macOS Alt key fix ---
keybind = alt+left=unbind
keybind = alt+right=unbind

# --- Split Management ---
keybind = alt+v=new_split:right
keybind = alt+d=new_split:down

# --- Split Navigation ---
keybind = alt+k=goto_split:up
keybind = alt+j=goto_split:down
keybind = alt+h=goto_split:left
keybind = alt+l=goto_split:right

# --- Split Resize ---
keybind = ctrl+shift+j=resize_split:up,10
keybind = ctrl+shift+k=resize_split:down,10
keybind = ctrl+shift+h=resize_split:left,10
keybind = ctrl+shift+l=resize_split:right,10

# --- Text Navigation ---
keybind = cmd+left=text:\x1b[H
keybind = cmd+right=text:\x1b[F
keybind = cmd+shift+left=text:\x1b[1;4H
keybind = cmd+shift+right=text:\x1b[1;4F

# ┌──────────────────────────────────────────────────────────────────────────────┐
# │                                  THEME                                       │
# └──────────────────────────────────────────────────────────────────────────────┘

# --- Font ---
font-family = "JetBrainsMono Nerd Font"
font-size = 20
font-thicken = true
font-thicken-strength = 100

# --- Miscellaneous ---
adjust-cell-height = 3

# --- Base Colors ---
background = #24273a
foreground = #cad3f5
cursor-color = #f4dbd6
cursor-text = #24273a
selection-background = #363a4f
selection-foreground = #cad3f5

# --- Normal Colors ---
palette = 0=#494d64
palette = 1=#ed8796
palette = 2=#a6da95
palette = 3=#eed49f
palette = 4=#8aadf4
palette = 5=#f5bde6
palette = 6=#8bd5ca
palette = 7=#b8c0e0

# --- Bright Colors ---
palette = 8=#5b6078
palette = 9=#ed8796
palette = 10=#a6da95
palette = 11=#eed49f
palette = 12=#8aadf4
palette = 13=#f5bde6
palette = 14=#8bd5ca
palette = 15=#a5adcb

# ┌──────────────────────────────────────────────────────────────────────────────┐
# │                                  SYSTEM                                      │
# └──────────────────────────────────────────────────────────────────────────────┘

# --- Updates ---
auto-update = download
auto-update-channel = stable

# --- Cursor ---
copy-on-select = clipboard
cursor-style = bar
cursor-click-to-move = true
mouse-scroll-multiplier = precision:0.1
scrollback-limit = 999999999

# --- Clipboard ---
clipboard-read = allow
clipboard-write = allow
clipboard-trim-trailing-spaces = true

# --- Working directory ---
window-inherit-working-directory = true
tab-inherit-working-directory = true

# --- SHELL ---
shell-integration = detect
shell-integration-features = true

# --- URLs --- 
link-url = true