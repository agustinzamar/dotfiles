{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*": "allow"
  },
  "lsp": true,
  "agent": {
    "explore": {
      "model": "opencode/hy3-free",
    },
    "builder": {
      "description": "Write-capable implementation subagent on the cheap model.",
      "mode": "subagent",
      "model": "opencode/deepseek-v4-flash-free",
      "permission": {
        "edit": "allow",
        "write": "allow",
        "bash": "allow"
      }
    }
  },
  "mcp": {
    "atlassian": {
      "type": "remote",
      "url": "https://mcp.atlassian.com/v1/mcp/authv2",
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:CONTEXT7_API_KEY}"
      }
    },
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    }
  },
  "plugin": [
    //"opencode-anthropic-login-via-cli@latest",
    "@ex-machina/opencode-anthropic-auth",
    "@tarquinen/opencode-dcp@latest",
    "@dietrichgebert/ponytail@4.9.0",
    "opencode-pty",
    "context-mode"
  ],
  "small_model": "opencode/hy3-free",
  "autoupdate": true,
  "experimental": {
    "batch_tool": true,
    "continue_loop_on_deny": true
  },
  "provider": {
    "nvidia": {
	"whitelist": [
            "minimaxai/minimax-m3",
	    "deepseek-ai/deepseek-v4-flash-0731"
	]
    },	    
    "kilo": {
      "whitelist": [
        "kilo-auto/free",
        "tencent/hy3:free"
      ]
    },
    "xai": {
      "whitelist": [
        "xai/grok-4.6"
      ]
    }
  }
}
