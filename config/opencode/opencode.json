{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "shadcn-ui": {
        "type": "local",
        "command": ["npx", "@jpisnice/shadcn-ui-mcp-server", "--github-api-key", "{env:GITHUB_PAT}"]
      },
      "chrome-devtools": {
        "type": "local",
        "command": ["npx", "chrome-devtools-mcp@latest"]
      }
    }
  },
  "agents": {
    "explore": {
      "model": "opencode/deepseek-v4-flash-free"
    }
  }
}
