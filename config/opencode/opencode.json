{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "share": "disabled",
  "permission": {
    "*": "allow"
  },
  "plugin": [
    "@ex-machina/opencode-anthropic-auth@next",
    "@tarquinen/opencode-dcp@latest"
  ],
  "provider": {
    "anthropic": {
      "whitelist": [
        "claude-sonnet-5-5",
        "claude-opus-5-5"
      ]
    },
    "kilo": {
      "whitelist": [
        "kilo-auto/free"
      ]
    },
    "nvidia": {
      "whitelist": [
        "moonshotai/kimi-k3",
        "deepseek-ai/deepseek-v4.1-flash"
      ]
    },
    "openai": {
      "whitelist": [
        "gpt-6-astra",
        "gpt-6-luna",
        "gpt-6.1-sol"
      ]
    },
    "opencode-go": {
      "whitelist": [
        "deepseek-v4.1-flash"
      ]
    }
  },
  "mcp": {
    "atlassian": {
      "type": "remote",
      "url": "https://mcp.atlassian.com/v2/mcp"
    },
    "codegraph": {
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true,
      "type": "local"
    },
    "context7": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "servers": {
      "engram": {
        "command": [
          "/opt/homebrew/bin/engram",
          "mcp",
          "--tools=agent"
        ],
        "type": "local"
      },
      "mercadopago-mcp-server": {
        "type": "remote",
        "url": "https://mcp.mercadopago.com/mcp"
      },
      "resend": {
        "type": "remote",
        "url": "https://mcp.resend.com/mcp"
      },
      "youtrack": {
        "type": "remote",
        "url": "https://proyectos-jujuy.youtrack.cloud/mcp"
      }
    }
  },
  "agent": {
    "general": {
      "model": "openai/gpt-6-luna"
    },
    "explore": {
      "model": "openai/gpt-6-luna"
    }
  }
}
