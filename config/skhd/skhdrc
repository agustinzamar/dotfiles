# skhd configuration — Gentleman.Dots style (migrated from AeroSpace)

# Quickly restart the yabai launch agent
shift + ctrl + alt + cmd - r : launchctl kickstart -k "gui/${UID}/homebrew.mxcl.yabai"

# Focus windows
alt - h : yabai -m window --focus west
alt - j : yabai -m window --focus south
alt - k : yabai -m window --focus north
alt - l : yabai -m window --focus east

# Explicit focus rescue for the current space (alt + ctrl + space)
# Use this when macOS/yabai leaves focus on the desktop after closing/moving windows.
alt + shift + ctrl + cmd - space : ~/.config/yabai/focus-current-space-window.sh

# Move windows
alt + shift - h : yabai -m window --swap west
alt + shift - j : yabai -m window --swap south
alt + shift - k : yabai -m window --swap north
alt + shift - l : yabai -m window --swap east

# send window to desktop and follow focus
alt + shift - 1 : yabai -m window --space  1; yabai -m space --focus 1
alt + shift - 2 : yabai -m window --space  2; yabai -m space --focus 2
alt + shift - 3 : yabai -m window --space  3; yabai -m space --focus 3
alt + shift - 4 : yabai -m window --space  4; yabai -m space --focus 4
alt + shift - 5 : yabai -m window --space  5; yabai -m space --focus 5
alt + shift - 6 : yabai -m window --space  6; yabai -m space --focus 6
alt + shift - 7 : yabai -m window --space  7; yabai -m space --focus 7

# Resize with arrow keys
alt - left : yabai -m window --resize left:-50:0; yabai -m window --resize right:-50:0
alt - right : yabai -m window --resize right:50:0; yabai -m window --resize left:50:0
alt - up : yabai -m window --resize top:0:-50; yabai -m window --resize bottom:0:-50
alt - down : yabai -m window --resize bottom:0:50; yabai -m window --resize top:0:50

# Toggle split type for focused window
alt - e : yabai -m window --toggle split

# Switch to workspace
alt - 1 : yabai -m space --focus 1
alt - 2 : yabai -m space --focus 2
alt - 3 : yabai -m space --focus 3
alt - 4 : yabai -m space --focus 4
alt - 5 : yabai -m space --focus 5
alt - 6 : yabai -m space --focus 6
alt - 7 : yabai -m space --focus 7

# create desktop, move window and follow focus
shift + cmd - n : yabai -m space --create && \
                  index="$(yabai -m query --spaces --display | jq 'map(select(."native-fullscreen" == 0))[-1].index')" && \
                  yabai -m window --space "${index}" && \
                  yabai -m space --focus "${index}"

# create desktop and follow focus
shift + alt - n : yabai -m space --create && \
                  index="$(yabai -m query --spaces --display | jq 'map(select(."native-fullscreen" == 0))[-1].index')" && \
                  yabai -m space --focus "${index}"

# Fullscreen (alt + shift + f)
alt + shift - f : yabai -m window --toggle zoom-fullscreen

# Layout switching
alt + ctrl - b : yabai -m space --layout bsp
alt + ctrl - s : yabai -m space --layout stack

# Workspace back and forth (alt + tab)
alt - tab : yabai -m space --focus recent

# Move window to next monitor (alt + shift + tab)
alt + shift - tab : yabai -m window --display next; yabai -m display --focus next

# Balance layout (alt + shift + b)
alt + shift - b : yabai -m space --balance

# Toggle floating (alt + ctrl + f)
alt + ctrl - f : yabai -m window --toggle float
