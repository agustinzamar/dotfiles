#!/usr/bin/env zsh

FONT_FACE="JetBrainsMono Nerd Font"

PLUGIN_DIR="$HOME/.config/sketchybar/plugins-laptop"
PLUGIN_SHARED_DIR="$HOME/.config/sketchybar/plugins"
IMAGES_DIR="$HOME/.config/sketchybar/images"

sketchybar --bar \
    height=44 \
    color=0x00000000 \
    margin=0 \
    sticky=on \
    padding_left=23 \
    padding_right=23 \
    notch_width=188 \
    display=main

# Alternatiive background colors
# label.color=0xffffffff
# background.color=0x9924273a
sketchybar --default \
    background.color=0x66494d64 \
    background.corner_radius=5 \
    background.padding_right=7 \
    background.height=34 \
    icon.font="$FONT_FACE:Medium:19.0" \
    icon.padding_left=7 \
    icon.padding_right=7 \
    label.font="$FONT_FACE:Medium:15.0" \
    label.color=0xffcad3f5 \
    label.y_offset=0 \
    label.padding_left=0 \
    label.padding_right=7

# Spotifast publishes no playback event, so this item polls media-control
# instead of subscribing to a notification the app never posts.
sketchybar --add item spotifast e \
    --set spotifast \
    icon= \
    icon.y_offset=1 \
    icon.font="$FONT_FACE:Bold:20.0" \
    label.drawing=off \
    label.padding_left=3 \
    update_freq=5 \
    script="$PLUGIN_SHARED_DIR/spotifast.sh" \
    --subscribe spotifast mouse.clicked

# Native macOS Spaces and the Paneru indicator stay on the left, ahead of
# front_app.
for slot in {1..10}; do
    sketchybar --add item "native_space.$slot" left \
        --set "native_space.$slot" \
        drawing=off \
        icon.drawing=off \
        icon.color=0xff24273a \
        label.drawing=on \
        label.padding_left=7 \
        label.color=0xff24273a \
        background.color=0x66494d64
done
sketchybar --set native_space.1 update_freq=1 updates=on \
    script="zsh \"$PLUGIN_SHARED_DIR/native_spaces.sh\""

# The Paneru virtual-space indicator sits between the native Space pool and the
# front-app cluster. sketchybar lays left-side items out left-to-right in
# creation order, so this item must be added after the native_space pool and
# before front_app; a right-side item is instead laid out from the display edge
# inward and can never reach this position.
sketchybar --add item current_space left \
    --set current_space \
    background.color=0xfff5a97f \
    icon.color=0xff24273a \
    label.drawing=off \
    update_freq=1 \
    script="$PLUGIN_SHARED_DIR/current_space.sh"

sketchybar --add item front_app left \
    --set front_app \
    background.color=0xffa6da95 \
    background.padding_left=0 \
    background.padding_right=0 \
    icon.y_offset=1 \
    icon.color=0xff24273a \
    label.drawing=no \
    script="$PLUGIN_SHARED_DIR/front_app.sh" \
    --add item front_app.separator left \
    --set front_app.separator \
    background.color=0x00000000 \
    background.padding_left=-3 \
    icon= \
    icon.color=0xffa6da95 \
    icon.font="$FONT_FACE:Bold:20.0" \
    icon.padding_left=0 \
    icon.padding_right=0 \
    icon.y_offset=1 \
    label.drawing=no \
    --add item front_app.name left \
    --set front_app.name \
    background.color=0x00000000 \
    background.padding_right=0 \
    icon.drawing=off \
    label.font="$FONT_FACE:Bold:12.0" \
    label.drawing=yes

sketchybar --add bracket front_app_bracket \
    front_app \
    front_app.separator \
    front_app.name \
    --subscribe front_app front_app_switched

sketchybar --add item clock right \
    --set clock \
    icon=󰃰 \
    icon.color=0xffed8796 \
    update_freq=10 \
    script="$PLUGIN_SHARED_DIR/clock.sh"

sketchybar --add item battery right \
    --set battery \
    update_freq=20 \
    script="$PLUGIN_DIR/battery.sh"

sketchybar --add item volume right \
    --set volume \
    icon.color=0xff8aadf4 \
    label.drawing=true \
    script="$PLUGIN_SHARED_DIR/volume.sh" \
    --subscribe volume volume_change

# osascript -e 'quit app "Rectangle"'
# open -a Rectangle

# Provider logos keep session/weekly quotas readable beside the notch.
for provider in codex claude opencode; do
    case "$provider" in
        codex) usage_image="$IMAGES_DIR/$provider.png"; usage_color=0xffa6da95 ;;
        claude) usage_image="$IMAGES_DIR/$provider.png"; usage_color=0xfff5a97f ;;
        opencode) usage_image="$IMAGES_DIR/$provider.png"; usage_color=0xff8aadf4 ;;
    esac
        sketchybar --add item "usage.$provider" right \
            --set "usage.$provider" \
            background.padding_left=2 \
            background.padding_right=2 \
            icon="" \
            icon.width=60 \
            icon.background.drawing=on \
            icon.background.image="$usage_image" \
            icon.background.image.drawing=on \
            icon.background.image.scale=0.45 \
            icon.padding_left=2 \
            icon.padding_right=2 \
            label="" \
            label.color="$usage_color" \
            label.font="$FONT_FACE:Medium:11.0" \
            label.padding_right=0 \
            update_freq=0
done
# Only Codex schedules the shared request; the plugin updates all three items.
sketchybar --set 'usage.codex' update_freq=60 \
script="$PLUGIN_SHARED_DIR/usage_quotas.sh" \
--subscribe 'usage.codex' system_woke

##### Finalizing Setup #####
sketchybar --update
sketchybar --trigger space_change
