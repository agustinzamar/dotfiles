#!/usr/bin/env bash
# shellcheck source-path=SCRIPTDIR
set -Eeuo pipefail

BIN_NAME=$(basename "$0")
# Use pwd -P so that invoking dot through a symlink resolves to the
# real repo root. Otherwise doctor sees broken links.
DOTFILES_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
export DOTFILES_DIR

# --dry-run is global; pull it out before dispatching.
DRY_RUN=false
args=()
for arg in "$@"; do
  case "$arg" in
    --dry-run) DRY_RUN=true ;;
    *) args+=("$arg") ;;
  esac
done
export DRY_RUN
set -- "${args[@]}"

# shellcheck source=../install/common.sh
. "$DOTFILES_DIR/install/common.sh"
# shellcheck source=../install/links.sh
. "$DOTFILES_DIR/install/links.sh"
# shellcheck source=../install/git.sh
. "$DOTFILES_DIR/install/git.sh"
# shellcheck source=../install/tools.sh
. "$DOTFILES_DIR/install/tools.sh"
# shellcheck source=../install/claude-config.sh
. "$DOTFILES_DIR/install/claude-config.sh"
# shellcheck source=../install/opencode-config.sh
. "$DOTFILES_DIR/install/opencode-config.sh"

sub_help() {
  echo "Usage: $BIN_NAME <command> [--dry-run]"
  echo
  echo "Commands:"
  echo "   backup           Commit and push this repo"
  echo "   clean            Clean up caches"
  echo "   doctor           Check that required tools and symlinks are in place"
  echo "   edit             Open dotfiles in \$VISUAL"
  echo "   help             This help message"
  echo "   test             Run tests"
  echo "   unlink           Remove symlinks that point into this repo"
  echo "   update           Pull, upgrade packages, then re-run the install"
  echo
  echo "Install:"
  echo "   install              Install core tools (brew, zsh, fzf, ssh keys)"
  echo "   install git          Setup git config"
  echo "   install code         Install VS Code extensions"
  echo "   install macos        Apply macOS system defaults"
  echo "   install dock         Apply macOS Dock settings"
  echo "   install duti         Set default apps for file types"
  echo "   install ai [...]     Sync skills/plugins to AI tools"
  echo "   install --full       Install everything"
  echo
  local topic
  echo "Topics (installed by \`brew\`, or one at a time):"
  while read -r topic; do
    printf '   %-16s %s\n' "$topic" "$(head -1 "$(topic_path "$topic")" | sed 's/^# *//')"
  done < <(topics)
  echo
  echo "Optional topics (only when asked for by name):"
  while read -r topic; do
    printf '   %-16s %s\n' "$topic" "$(head -1 "$(topic_path "$topic")" | sed 's/^# *//')"
  done < <(optional_topics)
}

# Run every phase, then report failures. One broken phase should not
# prevent later ones from running.
sub_install() {
  local cmd="${1:-}"
  shift 2>/dev/null || true

  case "$cmd" in
    --all | -a | --full | -f)
      sub_full
      return $?
      ;;
    ai)
      sub_install_ai "$@"
      return $?
      ;;
    "" | bootstrap)
      log "Bootstrapping dotfiles"
      local phase failures=()
      for phase in link; do
        "sub_$phase" || failures+=("$phase")
      done
      install_tools
      install_claude_config
      install_opencode_config
      if ((${#failures[@]})); then
        log "Finished with failures: ${failures[*]}"
        return 1
      fi
      log "Bootstrap complete — run \`dot install\` again or \`dot install --full\` for everything"
      return 0
      ;;
    *)
      local sub
      case "$cmd" in
        links) sub=sub_link_shell ;;
        *) sub="sub_$cmd" ;;
      esac
      if declare -F "$sub" >/dev/null; then
        "$sub"
      elif topic_path "$cmd" >/dev/null; then
        install_topic "$cmd"
      else
        echo "'$cmd' is not an install command or topic." >&2
        return 1
      fi
      ;;
  esac
}

sub_install_ai() {
  _install_skills() {
    local tool="$1"
    local IFS='|' dir
    for dir in $link_dirs; do
      [[ -L "$dir" && ! -e "$dir" ]] && run rm "$dir"
    done

    local manifest="$DOTFILES_DIR/ai/skills.json"
    if [[ -f "$manifest" ]]; then
      local source skill
      while IFS=$'\t' read -r source skill; do
        [[ -z "$source" ]] && continue
        if [[ -z "$skill" || "$skill" == "null" ]]; then
          log "Installing skill [$tool]: $source"
          run pnpm dlx skills add "$source" --agent "$agent" -y
        else
          log "Installing skill [$tool]: $source/$skill"
          run pnpm dlx skills add "$source" --agent "$agent" --skill "$skill" -y
        fi
      done < <(jq -r '.skills[] | [.source, (.skill // null)] | @tsv' "$manifest" 2>/dev/null)
    fi

    [[ -d "$DOTFILES_DIR/ai/skills" && "$(ls -A "$DOTFILES_DIR/ai/skills" 2>/dev/null)" ]] || return 0
    for dir in $link_dirs; do
      link_file "ai/skills" "$dir"
    done
  }

  _install_plugins() {
    local manifest="$DOTFILES_DIR/ai/plugins.json"
    [[ -f "$manifest" ]] || return 0

    _install_cli_plugins() {
      local tool="$1" cli="$2" label="$3"
      if ! is_executable "$cli"; then
        echo "$label CLI not found; skipping plugins" >&2
        return 0
      fi

      local name repo marketplace_name marketplace_source plugin
      while IFS='|' read -r name repo marketplace_name marketplace_source plugin; do
        [[ -n "$plugin" ]] || continue
        log "Plugin [$tool]: $name ($repo)"
        if [[ -n "$marketplace_source" ]]; then
          if "$DRY_RUN"; then
            run "$cli" plugin marketplace add "$marketplace_source" || return
          else
            local marketplaces
            marketplaces=$("$cli" plugin marketplace list --json) || return
            jq -e --arg name "$marketplace_name" '.. | strings | select(. == $name)' \
              <<<"$marketplaces" >/dev/null || run "$cli" plugin marketplace add "$marketplace_source" || return
          fi
        fi
        case "$tool" in
          claude-code) run "$cli" plugin install --scope user "$plugin" || return ;;
          codex) run "$cli" plugin add "$plugin" || return ;;
        esac
      done < <(jq -r --arg tool "$tool" '.plugins[] | select(.install[$tool].plugin) |
        [.name, .repo, (.install[$tool].marketplace.name // ""),
         (.install[$tool].marketplace.source // ""), .install[$tool].plugin] | join("|")' "$manifest")
    }

    case "$agent" in
      claude-code) _install_cli_plugins claude-code claude "Claude Code" ;;
      codex) _install_cli_plugins codex codex Codex ;;
      opencode) log "No OpenCode V2-compatible plugins configured" ;;
      '*')
        _install_cli_plugins claude-code claude "Claude Code" || return
        _install_cli_plugins codex codex Codex || return
        log "No OpenCode V2-compatible plugins configured"
        ;;
    esac
  }

  # Parse: dot install ai [tool] [--skills|--plugins].
  # Without a flag, both skills and plugins run. Without a tool, all.
  local target="${1:-all}"
  shift 2>/dev/null || true
  # If the first positional looks like a flag (no tool given),
  # treat it as target=all and push it back as a flag.
  [[ "$target" == "--"* ]] && {
    set -- "$target" "$@"
    target=all
  }

  local agent link_dirs
  case "$target" in
    all)
      agent='*'
      link_dirs="$HOME/.claude/skills|$HOME/.agents/skills"
      ;;
    claude)
      agent=claude-code
      link_dirs="$HOME/.claude/skills"
      ;;
    codex | opencode)
      agent="$target"
      link_dirs="$HOME/.agents/skills"
      ;;
    *)
      echo "Usage: dot install ai [all|claude|codex|opencode] [--skills|--plugins]" >&2
      return 1
      ;;
  esac

  local do_skills=false do_plugins=false arg
  for arg in "$@"; do
    case "$arg" in
      --skills) do_skills=true ;;
      --plugins) do_plugins=true ;;
      *)
        echo "unknown flag: $arg" >&2
        return 1
        ;;
    esac
  done
  $do_skills || $do_plugins || {
    do_skills=true
    do_plugins=true
  }

  $do_skills && _install_skills "$target"
  $do_plugins && _install_plugins "$target"
  return 0
}

sub_full() {
  log "Full install"
  local phase failures=()
  for phase in brew link code macos duti git claude_config opencode_config; do
    "sub_$phase" || failures+=("$phase")
  done

  local topic
  while read -r topic; do
    install_topic "$topic" || log "Skipping topic: $topic"
  done < <(topics)

  while read -r topic; do
    install_topic "$topic" || log "Skipping optional topic: $topic"
  done < <(optional_topics)

  if ((${#failures[@]})); then
    log "Finished with failures: ${failures[*]}"
    return 1
  fi
  log "Installation complete"
}

install_topic() {
  local path
  path=$(topic_path "$1") || {
    echo "no such topic: $1" >&2
    return 1
  }
  log "Installing $1"
  run brew bundle --file="$path"
}

sub_brew() {
  log "Installing Homebrew"
  if is_executable brew; then
    echo 'Homebrew already installed, skipping'
  elif "$DRY_RUN"; then
    echo '+ install Homebrew'
  else
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  fi
}

sub_code() {
  if is_executable code; then
    log "Installing VS Code extensions"
    local installed extension
    installed=$(code --list-extensions 2>/dev/null | tr '[:upper:]' '[:lower:]')
    while read -r extension; do
      grep -qxF "$(tr '[:upper:]' '[:lower:]' <<<"$extension")" <<<"$installed" ||
        run code --install-extension "$extension"
    done < <(read_package_file "$DOTFILES_DIR/install/Codefile")
  else
    echo "VS Code not installed, skipping extension setup" >&2
  fi
}

sub_duti() {
  if is_executable duti; then
    log "Setting default apps for file types"
    run duti -v "$DOTFILES_DIR/install/duti" 2>&1 | grep -v "error -50" || true
  else
    echo "duti not installed, skipping default app setup" >&2
  fi
}

sub_git() {
  log "Configuring git"
  install_git
}

sub_claude_config() {
  log "Installing Claude defaults"
  install_claude_config
}

sub_opencode_config() {
  log "Installing Opencode defaults"
  install_opencode_config
}

sub_link() {
  log "Linking dotfiles"
  link_all
}

sub_link_shell() {
  log "Linking shell dotfiles"
  link_shell
}

sub_unlink() {
  log "Removing symlinks"
  unlink_all
}

sub_macos() {
  apply_defaults "$DOTFILES_DIR/system/defaults/macos.sh"
  echo "Some changes may require a logout or restart to take effect."
}

sub_dock() {
  apply_defaults "$DOTFILES_DIR/system/defaults/dock.sh"
}

sub_chrome() {
  apply_defaults "$DOTFILES_DIR/system/defaults/chrome.sh"
}

sub_rectangle() {
  apply_defaults "$DOTFILES_DIR/system/defaults/rectangle.sh"
}

sub_doctor() {
  local failed=0 command
  check() {
    command -v "$1" >/dev/null 2>&1 || {
      echo "missing: $1"
      failed=1
    }
  }
  check_link() {
    [[ -L "$2" && "$(readlink "$2")" == "$DOTFILES_DIR/$1" ]] || {
      echo "broken: $2"
      failed=1
    }
  }

  for command in brew git; do check "$command"; done
  is_executable dot || {
    echo "not on PATH: dot (link system/.exports, then restart your shell)"
    failed=1
  }
  check_link config/zsh/.zshrc "$HOME/.zshrc"
  check_link config/p10k/.p10k.zsh "$HOME/.p10k.zsh"
  check_link config/ghostty/config "$HOME/.config/ghostty/config"
  check_link config/tmux/tmux.conf "$HOME/.config/tmux/tmux.conf"
  if ((failed == 0)); then echo "dotfiles: healthy"; fi
  return "$failed"
}

sub_update() {
  run git -C "$DOTFILES_DIR" pull
  if is_executable topgrade; then
    run topgrade
  else
    run brew update
    run brew upgrade
  fi
  sub_full
}

sub_backup() {
  if [[ -z "$(git -C "$DOTFILES_DIR" status --porcelain)" ]]; then
    echo "No changes to commit."
    return 0
  fi
  run git -C "$DOTFILES_DIR" add -A
  run git -C "$DOTFILES_DIR" commit -m "backup: $(date '+%Y-%m-%d %H:%M')"
  run git -C "$DOTFILES_DIR" push
}

sub_clean() {
  if is_executable mole; then run mole clean; fi
  run brew cleanup
  if is_executable pnpm; then run pnpm store prune; fi
}

sub_edit() {
  sh -c "${VISUAL:-code} $DOTFILES_DIR"
}

sub_test() {
  bats "$DOTFILES_DIR"/test/*.bats
}

TOP_COMMANDS=" backup clean doctor edit help install test unlink update "

COMMAND_NAME=${1:-}
case "$COMMAND_NAME" in
  "" | -h | --help | help)
    sub_help
    ;;
  *)
    shift
    if [[ "$TOP_COMMANDS" == *" $COMMAND_NAME "* ]]; then
      "sub_${COMMAND_NAME//-/_}" "$@"
    else
      echo "'$COMMAND_NAME' is not a known command." >&2
      sub_help >&2
      exit 1
    fi
    ;;
esac
