#!/usr/bin/env bash
# shellcheck source-path=SCRIPTDIR
set -Eeuo pipefail

BIN_NAME=$(basename "$0")
# Use pwd -P so that invoking dot through a symlink resolves to the
# real repo root. Otherwise doctor sees broken links.
DOTFILES_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
export DOTFILES_DIR

# --dry-run is global; pull it out before dispatching.
DRY_RUN=false
args=()
for arg in "$@"; do
  case "$arg" in
    --dry-run) DRY_RUN=true ;;
    *) args+=("$arg") ;;
  esac
done
export DRY_RUN
set -- ${args[@]+"${args[@]}"}

# shellcheck source=../install/common.sh
. "$DOTFILES_DIR/install/common.sh"
# shellcheck source=../install/platform.sh
. "$DOTFILES_DIR/install/platform.sh"
# shellcheck source=../install/components.sh
. "$DOTFILES_DIR/install/components.sh"
# shellcheck source=../install/links.sh
. "$DOTFILES_DIR/install/links.sh"
# shellcheck source=../install/manifest.sh
. "$DOTFILES_DIR/install/manifest.sh"
# shellcheck source=../install/git.sh
. "$DOTFILES_DIR/install/git.sh"
# shellcheck source=../install/php.sh
. "$DOTFILES_DIR/install/php.sh"

sub_help() {
  echo "Install (use \`dot install <name>\`):"
  echo "   install [--dry-run]         Open the interactive installer"
  echo "   install --all [--dry-run]   Install every standard phase headlessly"
  echo "   install <topic> [--dry-run] Install a topic: $(topic_names)"
  echo
  echo "Commands:"
  echo "   agents sync [--dry-run] Refresh agent instruction files from the repository"
  echo "   doctor                  Check that required tools and symlinks are in place"
  echo "   help                    This help message"
  echo "   unlink [--dry-run]      Remove symlinks that point into this repo"
  echo "   update [--dry-run]      Pull latest dotfiles and upgrade installed packages"
  echo
  echo "Config links:"
  echo "   link [--dry-run]        Symlink selected configs whose tools are available"
  echo "   link <name> [--dry-run] Symlink one config or group: $(link_names)"
}

# Resolve an `install` subcommand or topic name to what runs it. Echoes the
# sub_* function name, or `topic:<name>` for a Brewfile topic; fails if
# neither exists. Shared by sub_install and the top-level dispatcher below so
# a bare `dot brew` and `dot install brew` recognize the same set of names.
resolve_install_target() {
  local cmd="$1"
  # Commands are kebab-case, function names are snake_case, the same way the
  # top-level dispatcher translates them.
  local sub="sub_${cmd//-/_}"
  if declare -F "$sub" >/dev/null; then
    printf '%s' "$sub"
  elif topic_path "$cmd"; then
    printf 'topic:%s' "$cmd"
  else
    return 1
  fi
}

# Refuse an entry point that installs packages when this host has no Homebrew
# to install them with. Refusing up front beats failing halfway through a phase
# list, and beats a dry run that prints brew commands this machine can never
# run. Only the package-installing entry points call this: `dot install macos`,
# `code` and `duti` have their own installers and stay available everywhere.
_reject_package_install() {
  [[ "$(os_family)" != macos ]] || return 0
  echo "refusing: \`dot $*\` installs packages with Homebrew, which this repo only supports on macOS (detected: $(os_family))." >&2
  echo "dot link, dot unlink, dot doctor and dot git work here." >&2
  return 1
}

# Run every phase, then report failures. One broken phase should not
# prevent later ones from running.
sub_install() {
  local cmd="${1:-}"
  shift 2>/dev/null || true

  case "$cmd" in
    --all | -a)
      _reject_package_install install "$cmd" || return 1
      local dry_run=false
      [[ "${1:-}" == "--dry-run" ]] && dry_run=true
      sub_full "$dry_run"
      return $?
      ;;
    link | links)
      echo "'install $cmd' is gone — use \`dot $cmd\` directly (see \`dot link help\`)" >&2
      return 1
      ;;
    "")
      _reject_package_install install || return 1
      run_interactive_install
      ;;
    *)
      local target
      if target=$(resolve_install_target "$cmd"); then
        case "$target" in
          topic:*)
            _reject_package_install install "$cmd" || return 1
            install_topic "${target#topic:}"
            ;;
          *) "$target" ;;
        esac
      else
        echo "'$cmd' is not an install command or topic." >&2
        return 1
      fi
      ;;
  esac
}

# Interactive default for bare `dot install` — runs headless install with all topics.
# Order: TTY guard FIRST (piped curl dies in ms), then headless install with --all.
# Exit mapping: 0 → applied summary, 10 → aborted (nothing installed/linked),
# any other non-zero → propagate loudly. PATH is normalized so the installer's
# brew steps and subprocesses see the known package-manager locations even when
# the launching shell runs a bare macOS GUI PATH.
run_interactive_install() {
  if [[ ! -t 0 ]]; then
    echo "stdin is not a TTY — use \`dot install --all\` or \`dot install <topic>\`" >&2
    return 1
  fi

  # Known Homebrew/bun locations, prepended so subprocesses see them.
  export PATH="$HOME/.bun/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"

  # Run headless install with --all (no TUI)
  local exit_code=0
  local args=()
  "$DRY_RUN" && args+=(--dry-run)
  install_headless "${args[@]}" || exit_code=$?

  case "$exit_code" in
    0)
      log "Installation complete — selected components installed, configs linked"
      ;;
    10)
      echo "aborted — nothing installed, nothing linked"
      return 0
      ;;
    *)
      echo "installer exited with status $exit_code" >&2
      return "$exit_code"
      ;;
  esac
}

# Headless install with --all (no TUI). Supports --dry-run flag.
install_headless() {
  local dry_run=false
  if [[ "$1" == "--dry-run" ]]; then
    dry_run=true
  fi

  local phase failures=()
  for phase in bootstrap brew php link zsh code macos duti git skills; do
    if [[ "$dry_run" == true ]]; then
      echo "🔧 Would run: sub_$phase"
    else
      "sub_$phase" || failures+=("$phase")
    fi
  done

  if ((${#failures[@]})); then
    echo "❌ Finished with failures: ${failures[*]}" >&2
    return 1
  fi
  if [[ "$dry_run" == false ]]; then
    log "Installation complete"
  fi
}

sub_baseline() {
  log "Installing baseline tools"
  run_step "Core command-line tools" installed brew install go zsh fzf git gh lazygit hunk tmux yazi neovim
  run_step "Ghostty" installed brew install --cask ghostty
  sub_zsh
  sub_git
}

sub_full() {
  local dry_run="${1:-false}"
  [[ "$dry_run" == true ]] && export DRY_RUN=true
  log "Full install"
  local phase failures=()
  for phase in bootstrap brew php link zsh code macos duti git skills; do
    if [[ "$dry_run" == true ]]; then
      echo "🔧 Would run: sub_$phase"
    else
      "sub_$phase" || failures+=("$phase")
    fi
  done

  if ((${#failures[@]})); then
    echo "❌ Finished with failures: ${failures[*]}" >&2
    return 1
  fi
  log "Installation complete"
}

# Installs a topic by name from install/topics/<name>.
install_topic() {
  local name="$1"
  local core="$TOPIC_DIR/$name"
  if [[ -f "$core" ]]; then
    run_topic_file "$name" "$core"
    return 0
  fi
  echo "no such topic: $name" >&2
  return 1
}

sub_bootstrap() {
  log "Bootstrap: Xcode CLT + Homebrew (idempotent)"

  # Known-path checks, never PATH-dependent: a GUI-launched terminal on macOS
  # starts with /usr/bin:/bin:/usr/sbin:/sbin, so `type brew`/`xcode-select`
  # can miss installs that are actually present and trigger a reinstall.
  local xc=/usr/bin/xcode-select brew_bin=""
  for candidate in /opt/homebrew/bin/brew /usr/local/bin/brew; do
    [[ -x "$candidate" ]] && brew_bin=$candidate
  done

  if "$xc" -p >/dev/null 2>&1; then
    echo '✅ Xcode already installed'
  elif "$DRY_RUN"; then
    echo '+ install Xcode CLT'
  else
    run "$xc" --install
  fi

  if [[ -n "$brew_bin" ]]; then
    echo "✅ Homebrew already installed ($brew_bin)"
  elif "$DRY_RUN"; then
    echo '+ install Homebrew'
  else
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    brew_bin=/opt/homebrew/bin/brew
    [[ -x "$brew_bin" ]] || brew_bin=/usr/local/bin/brew
  fi
}

sub_brew() {
  log "Installing Homebrew packages"
  local topic failures=()
  while read -r topic; do
    # `code` and `duti` live in topics/ but are plain lists, not Brewfiles:
    # sub_code and sub_duti read them, and `brew bundle` chokes on both. A
    # topic with its own installer is not this loop's business.
    declare -F "sub_$topic" >/dev/null && continue
    run_topic_file "$topic" "$TOPIC_DIR/$topic" || failures+=("$topic")
  done < <(topics)

  if ((${#failures[@]})); then
    log "topics that failed: ${failures[*]}"
    return 1
  fi
}

sub_php() {
  log "PHP extensions (pecl)"
  install_php_extensions
}

sub_zsh() {
  log "Setting up Zsh"

  # .zshrc only sources zinit; installing it from an interactive shell would
  # mean cloning from GitHub before the prompt can be drawn.
  local zinit_home="${XDG_DATA_HOME:-$HOME/.local/share}/zinit/zinit.git"
  if [[ -r "$zinit_home/zinit.zsh" ]]; then
    echo '✅ zinit already installed'
  else
    run mkdir -p "$(dirname "$zinit_home")"
    run git clone --depth=1 https://github.com/zdharma-continuum/zinit.git "$zinit_home"
  fi

  # Handle fzf post install script
  local brew_prefix
  brew_prefix=$(brew --prefix 2>/dev/null || true)
  if [[ -n "$brew_prefix" && -x "$brew_prefix/opt/fzf/install" ]]; then
    # --no-update-rc: --all would otherwise append a source line to ~/.zshrc,
    # which is a symlink into this repo, so the installer edits a tracked file
    # on every run. .zshrc sources ~/.fzf.zsh instead.
    run_step "fzf key bindings" installed "$brew_prefix/opt/fzf/install" --all --no-update-rc --no-bash --no-fish
  fi
}

sub_code() {
  if is_executable code; then
    log "Installing VS Code extensions"
    local installed extension present added
    present=0
    added=0
    installed=$(code --list-extensions 2>/dev/null | tr '[:upper:]' '[:lower:]')
    while read -r extension; do
      if grep -qxF "$(tr '[:upper:]' '[:lower:]' <<<"$extension")" <<<"$installed"; then
        present=$((present + 1))
        continue
      fi
      echo "-- $extension"
      run code --install-extension "$extension"
      added=$((added + 1))
    done < <(read_package_file "$DOTFILES_DIR/install/topics/code")
    # Without this the step prints a heading and nothing else on a machine that
    # already has every extension, which reads like it did no work.
    echo "$present already installed, $added added"
  else
    echo "⚠️ VS Code not installed; skipping extension setup" >&2
  fi
}

sub_duti() {
  if is_executable duti; then
    log "Setting default apps for file types"
    # ponytail: only register apps that are actually installed. A stale LaunchServices
    # registration (e.g. an uninstalled VLC) makes duti prompt a Gatekeeper "keep this
    # program?" dialog. Filter the topic to installed bundle ids before handing it to duti.
    local tmp
    tmp=$(mktemp)
    while read -r bid rest; do
      app=$(mdfind "kMDItemCFBundleIdentifier == '$bid'" 2>/dev/null | head -1)
      if [ -n "$app" ]; then
        printf '%s %s\n' "$bid" "$rest" >>"$tmp"
      else
        echo "⚠️ $bid not installed; skipping" >&2
      fi
    done <"$DOTFILES_DIR/install/topics/duti"
    run duti -v "$tmp" 2>&1 | grep -v "error -50" || true
    rm -f "$tmp"
  else
    echo "⚠️ duti not installed; skipping default app setup" >&2
  fi
}

sub_git() {
  log "Configuring git"
  install_git

  # --apple-use-keychain is a macOS-only ssh-add flag; anywhere else it is an
  # unknown option and the key never gets registered. Empty array plus the `+`
  # expansion so `set -u` tolerates the non-macOS case.
  local -a flags=()
  if [[ "$(os_family)" == macos ]]; then
    flags=(--apple-use-keychain)
  fi

  # `|| continue` rather than `&&`: as a function body under `set -e`, a final
  # falsy test would abort the whole install run.
  for key in "$HOME"/.ssh/id_*; do
    case "$key" in *.pub | *.revoked) continue ;; esac
    [[ -f "$key" ]] || continue
    run ssh-add ${flags[@]+"${flags[@]}"} "$key"
  done
}

sub_skills() {
  if ! is_executable pnpm; then
    echo "⚠️ pnpm not installed; skipping skills installation" >&2
    return 0
  fi

  local skills_file="$DOTFILES_DIR/config/ai/skills.json"
  [[ -f "$skills_file" ]] || {
    echo "⚠️ $skills_file not found" >&2
    return 0
  }

  # In dry-run mode, just show what would be installed
  if [[ "$DRY_RUN" == true ]]; then
    echo "Skills installation (dry-run)"
    echo "-------------------"
    echo "Would prompt for scope (local/global) and skill selection"
    echo "Skills available:"
    jq -r '
      .skills[] |
      if .skills then
        .skills[] as $s | "  - \($s) from \(.source)"
      else
        "  - \(.id) (\(.label)) from \(.source)"
      end
    ' "$skills_file"
    return 0
  fi

  echo "Skills installation"
  echo "-------------------"

  # Ask for scope: local or global
  local scope=""
  while [[ -z "$scope" ]]; do
    read -r -p "Install scope [local/global]: " scope
    case "$scope" in
      local|global) ;;
      *) echo "Please enter 'local' or 'global'"; scope="" ;;
    esac
  done

  # Extract all individual skills from skills.json using jq
  local skills=()
  local labels=()
  local sources=()

  while IFS=$'\t' read -r skill label source; do
    skills+=("$skill")
    labels+=("$label")
    sources+=("$source")
  done < <(jq -r '
    .skills[] |
    if .skills then
      .skills[] as $s | "\($s)\t\($s)\t\(.source)"
    else
      "\(.id)\t\(.label)\t\(.source)"
    end
  ' "$skills_file")

  if [[ ${#skills[@]} -eq 0 ]]; then
    echo "No skills found in $skills_file"
    return 0
  fi

  echo ""
  echo "Available skills:"
  for i in "${!skills[@]}"; do
    printf "  %2d) %s (%s from %s)\n" $((i+1)) "${labels[i]}" "${skills[i]}" "${sources[i]}"
  done
  echo ""

  # Interactive selection using checkboxes
  local selected=()
  for i in "${!skills[@]}"; do
    local default="y"
    read -r -p "Install ${labels[i]} (${skills[i]})? [Y/n]: " choice
    case "$choice" in
      [Nn]*) default="n" ;;
      *) default="y" ;;
    esac
    if [[ "$default" == "y" ]]; then
      selected+=("${skills[i]}")
    fi
  done

  if [[ ${#selected[@]} -eq 0 ]]; then
    echo "No skills selected."
    return 0
  fi

  echo ""
  echo "Installing ${#selected[@]} skill(s) with scope: $scope"
  for skill in "${selected[@]}"; do
    echo "  → $skill"
    if [[ "$DRY_RUN" == true ]]; then
      echo "    (dry-run) pnpm dlx @mattpocock/skills add $skill --scope $scope --yes"
    else
      run pnpm dlx @mattpocock/skills add "$skill" --scope "$scope" --yes
    fi
  done

  echo "✅ Skills installation complete"
}

sub_link() {
  local target="${1:-}"
  shift 2>/dev/null || true
  case "$target" in
    "")
      log "Linking dotfiles"
      link_all
      ;;
    --all | all)
      log "Force-linking every config"
      LINK_FORCE=true link_all
      ;;
    help)
      echo "Usage: $BIN_NAME link [target]"
      echo "   (no target)  Symlink every config into place"
      echo "   --all        Force-link every config explicitly"
      echo "   <name>       Symlink one config: $(link_names)"
      echo "   opt-in only  $(optional_link_names) — skipped by a bare \`link\`"
      ;;
    *)
      LINK_FORCE=true link_named "$target"
      ;;
  esac
}

# True when version $1 is at least version $2 (dot-separated numbers).
version_at_least() {
  [[ $(printf '%s\n' "$1" "$2" | sort -V | head -n1) == "$2" ]]
}

sub_unlink() {
  log "Removing symlinks"
  unlink_all
}

sub_macos() {
  apply_defaults "$DOTFILES_DIR/system/defaults/macos.sh"
  echo "Some changes may require a logout or restart to take effect."
}

sub_dock() {
  apply_defaults "$DOTFILES_DIR/system/defaults/dock.sh"
}

sub_doctor() {
  local failed=0 command
  check() {
    command -v "$1" >/dev/null 2>&1 || {
      echo "missing: $1"
      failed=1
    }
  }
  # Takes the same (source, target, mode, requirement) a link map row carries,
  # so the whole map can be walked instead of a hand-kept subset that goes stale.
  # shellcheck disable=SC2329  # called by name from _walk_links
  check_link() {
    local source=$1 target=$2 mode=${3:-} requirement=${4:-}
    # An app-writable target is a live file on purpose, never a symlink.
    [[ "$mode" == app-writable ]] && return 0
    # A requirement-gated row is absent by design when its tool is not
    # installed: `dot link` skipped it, so it is not a fault.
    if [[ -n "$requirement" ]] && ! is_executable "$(platform_binary "$requirement")"; then
      return 0
    fi
    [[ -L "$target" && "$(readlink "$target")" == "$DOTFILES_DIR/$source" ]] || {
      echo "broken: $target"
      failed=1
    }
  }

  # jq reads the ai/ manifests; without it `dot ai` cannot run at all. git, jq
  # and `dot` on PATH (below) are universal — every OS family, `unknown` too.
  for command in git jq; do check "$command"; done
  # Homebrew is the manager this repo installs through, and only on macOS.
  # Gating on os_family rather than on os_pkg_manager is deliberate: the latter
  # reports what is PRESENT, so it would silence the check exactly on the
  # machine that is missing brew. check_link needs no such branch — all_links
  # already yields only the rows that apply here.
  if [[ "$(os_family)" == macos ]]; then check brew; fi
  is_executable dot || {
    echo "not on PATH: dot (run \`dot link\` then restart your shell; the repo must live at ~/dotfiles)"
    failed=1
  }
  # Opt-in links stay out of this: not having them is a choice, not a fault.
  _walk_links all_links check_link
  if ((failed == 0)); then echo "dotfiles: healthy"; fi
  return "$failed"
}

sub_update() {
  run git -C "$DOTFILES_DIR" pull
  # A pull can add a row to the link map; linking is idempotent, so re-run it
  # here rather than leaving the new config unlinked until the next install.
  sub_link
  if is_executable topgrade; then
    run topgrade
  else
    run brew update
    run brew upgrade
  fi
}

sub_backup() {
  local untracked
  if [[ -z "$(git -C "$DOTFILES_DIR" status --porcelain)" ]]; then
    echo "No changes to commit."
    return 0
  fi

  # Tracked changes only. This repo is public, so a stray file in the working
  # tree must be added on purpose, not swept in by a backup command.
  untracked=$(git -C "$DOTFILES_DIR" ls-files --others --exclude-standard)
  if [[ -n "$untracked" ]]; then
    printf '\nNot committed, untracked — add them yourself if you want them:\n%s\n' "$untracked" >&2
  fi

  if git -C "$DOTFILES_DIR" diff --quiet && git -C "$DOTFILES_DIR" diff --cached --quiet; then
    echo "Nothing tracked to commit."
    return 0
  fi
  run git -C "$DOTFILES_DIR" add -u
  run git -C "$DOTFILES_DIR" commit -m "backup: $(date '+%Y-%m-%d %H:%M')"
  run git -C "$DOTFILES_DIR" push
}

sub_clean() {
  if is_executable mole; then
    if ! "$DRY_RUN" && ! sudo -n true 2>/dev/null; then
      printf '\n==> 🔒 Requesting administrator access\n'
      if ! sudo -v; then
        echo '❌ Administrator access failed' >&2
        return 1
      fi
    fi

    # run_step captures output, so Mole's terminal sudo prompt would be
    # invisible and wait forever. Close stdin after the initial sudo prompt.
    run_step "Mole cleanup" complete mole clean </dev/null || return 1
  fi
  run_step "Homebrew cleanup" complete brew cleanup
}

sub_edit() {
  sh -c "${VISUAL:-code} $DOTFILES_DIR"
}

# dot agents sync — refresh agent instruction files from the repository source.
sub_agents() {
  local cmd="${1:-}"
  case "$cmd" in
    sync)
      shift
      "$DOTFILES_DIR/install/agents.sh" "$@"
      ;;
    *)
      echo "Usage: $BIN_NAME agents sync" >&2
      return 1
      ;;
  esac
}

TOP_COMMANDS=" agents backup clean doctor edit help install link unlink update "

COMMAND_NAME=${1:-}
case "$COMMAND_NAME" in
  "" | -h | --help | help)
    sub_help
    ;;
  # Hidden: the TUI runs `dot bootstrap` as the first step of its apply phase
  # so Xcode CLT + Homebrew are installed only after the user confirms a
  # selection (never before the selector appears). Intentionally not in
  # TOP_COMMANDS / help.
  bootstrap)
    shift
    sub_bootstrap "$@"
    ;;
  *)
    shift
    if [[ "$TOP_COMMANDS" == *" $COMMAND_NAME "* ]]; then
      "sub_${COMMAND_NAME//-/_}" "$@"
    else
      echo "'$COMMAND_NAME' is not a known command." >&2
      sub_help >&2
      exit 1
    fi
    ;;
esac
