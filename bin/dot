#!/usr/bin/env bash
# shellcheck source-path=SCRIPTDIR
set -Eeuo pipefail

BIN_NAME=$(basename "$0")
# Use pwd -P so that invoking dot through a symlink resolves to the
# real repo root. Otherwise doctor sees broken links.
DOTFILES_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
export DOTFILES_DIR

# --dry-run is global; pull it out before dispatching.
DRY_RUN=false
args=()
for arg in "$@"; do
  case "$arg" in
    --dry-run) DRY_RUN=true ;;
    *) args+=("$arg") ;;
  esac
done
export DRY_RUN
set -- ${args[@]+"${args[@]}"}

# shellcheck source=../install/common.sh
. "$DOTFILES_DIR/install/common.sh"
# shellcheck source=../install/components.sh
. "$DOTFILES_DIR/install/components.sh"
# shellcheck source=../install/links.sh
. "$DOTFILES_DIR/install/links.sh"
# shellcheck source=../install/manifest.sh
. "$DOTFILES_DIR/install/manifest.sh"
# shellcheck source=../install/git.sh
. "$DOTFILES_DIR/install/git.sh"
# shellcheck source=../install/ai.sh
. "$DOTFILES_DIR/install/ai.sh"

sub_help() {
  echo "Usage: $BIN_NAME <command> [options]"
  echo "Options: --dry-run"
  echo
  echo "Commands:"
  echo "   doctor           Check that required tools and symlinks are in place"
  echo "   help             This help message"
  echo "   test             Run tests"
  echo "   unlink           Remove symlinks that point into this repo"
  echo "   update           Pull latest dotfiles and upgrade installed packages"
  echo
  echo "Config links:"
  echo "   link             Symlink selected configs whose tools are available"
  echo "   link <name>      Symlink one config or group: $(link_names)"
  echo "   link --all       Symlink every config explicitly"
  echo
  echo "Install (each also works as \`dot <name>\`, no \`install\` needed):"
  echo "   install              Open the interactive installer — requires a TTY"
  echo "   install --all        Install every standard phase headlessly; AI stays opt-in"
  echo "   install --profile PATH  Apply a saved component profile headlessly"
  echo "   install --dry-run --profile PATH  Preview a saved component profile"
  echo "   install <topic>      Install a topic: $(topic_names)"
  echo
  echo "AI extras (opt-in — no install phase runs these):"
  echo "   ai                   Install skills and plugins for every agent CLI found"
  echo "   ai <agent>           Limit to one agent: $(ai_agent_names)"
  echo "   ai --skills          Skills only (add --plugins for plugins only)"
  echo "   link agents          Point the agent CLIs at ai/AGENTS.md"
}

# Resolve an `install` subcommand or topic name to what runs it. Echoes the
# sub_* function name, or `topic:<name>` for a Brewfile topic; fails if
# neither exists. Shared by sub_install and the top-level dispatcher below so
# a bare `dot brew` and `dot install brew` recognize the same set of names.
resolve_install_target() {
  local cmd="$1"
  # Commands are kebab-case, function names are snake_case, the same way the
  # top-level dispatcher translates them.
  local sub="sub_${cmd//-/_}"
  if declare -F "$sub" >/dev/null; then
    printf '%s' "$sub"
  elif topic_path "$cmd"; then
    printf 'topic:%s' "$cmd"
  else
    return 1
  fi
}

# Run every phase, then report failures. One broken phase should not
# prevent later ones from running.
sub_install() {
  local cmd="${1:-}"
  shift 2>/dev/null || true

  if [[ "$cmd" == --profile ]]; then
    run_profile_install "${1:-${XDG_CONFIG_HOME:-$HOME/.config}/dot/profile.json}"
    return $?
  fi

  case "$cmd" in
    --all | -a)
      sub_full
      return $?
      ;;
    ai)
      sub_ai "$@"
      return $?
      ;;
    link | links)
      echo "'install $cmd' is gone — use \`dot $cmd\` directly (see \`dot link help\`)" >&2
      return 1
      ;;
    "")
      run_interactive_install
      ;;
    *)
      local target
      if target=$(resolve_install_target "$cmd"); then
        case "$target" in
          topic:*) install_topic "${target#topic:}" ;;
          *) "$target" ;;
        esac
      else
        echo "'$cmd' is not an install command or topic." >&2
        return 1
      fi
      ;;
  esac
}

# Interactive default for bare `dot install` (user decision: TUI first, then
# bootstrap on confirm). Order: TTY guard FIRST (piped curl dies in ms), then
# only the installer's own runtime — a prebuilt bin/dot-tui needs nothing, so
# on the normal path nothing is provisioned before the selector. Xcode CLT /
# Homebrew / bun are installed by the `dot bootstrap` step the TUI runs at the
# START of its apply phase (post-confirm), never before the user chooses.
# Exit mapping: 0 → applied summary, 10 → aborted (nothing installed/linked),
# any other non-zero → propagate loudly. PATH is normalized so the TUI's brew
# steps and subprocesses see the known package-manager locations even when the
# launching shell runs a bare macOS GUI PATH.
run_interactive_install() {
  if [[ ! -t 0 ]]; then
    echo "stdin is not a TTY — use \`dot install --all\` or \`dot install --profile <path>\`" >&2
    return 1
  fi

  # Known Homebrew/bun locations, prepended: GUI-launched terminals and the
  # TUI's `sh -c` steps inherit this and can actually find brew/bun. Applied
  # AFTER resolving the runtime so the resolver sees the caller's environment.
  local bin ctx exit_code=0
  bin=$(dot_runtime_path) || {
    echo "TUI unavailable — use \`dot install --all\` or \`dot install --profile <path>\` for a headless install" >&2
    return 1
  }
  export PATH="$HOME/.bun/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
  ctx=$(mktemp) || return 1
  install_context_json "$ctx" || {
    rm -f "$ctx"
    return 1
  }

  local args=(--context "$ctx")
  "$DRY_RUN" && args+=(--dry-run)
  "$bin" "${args[@]}" || exit_code=$?
  rm -f "$ctx"

  case "$exit_code" in
    0)
      log "Installation complete — selected components installed, configs linked"
      ;;
    10)
      echo "aborted — nothing installed, nothing linked"
      return 0
      ;;
    *)
      echo "installer exited with status $exit_code" >&2
      return "$exit_code"
      ;;
  esac
}

# Resolve the TUI binary (prebuilt or one-time build) without provisioning a
# package manager. Lookup order for bun: PATH honors the environment and any
# stubs, then known Homebrew/~/.bun locations catch GUI-launched terminals
# that never put those dirs on PATH. Set DOT_RUNTIME_BUN_LOOKUP=path to force
# PATH-only (the bats suite does, so its fake-bun stubs stay deterministic).
dot_runtime_path() {
  local bin="$DOTFILES_DIR/bin/dot-tui"
  # Version-gated prebuilt: only trust a binary whose marker matches the
  # current TUI contract. A stale/foreign binary (old pre-delta build) prints
  # nothing or an old marker, so it falls through to a rebuild — a checked-out
  # repo can never silently run an outdated installer UI.
  if [[ -x "$bin" ]] && [[ "$("$bin" --version 2>/dev/null)" == "dot-tui-context-v4" ]]; then
    printf '%s\n' "$bin"
    return 0
  fi

  local required installed bun_bin=""
  if [[ "${DOT_RUNTIME_BUN_LOOKUP:-}" != path ]]; then
    for candidate in "$HOME/.bun/bin/bun" /opt/homebrew/bin/bun /usr/local/bin/bun; do
      [[ -x "$candidate" ]] && bun_bin=$candidate
    done
  fi
  if [[ -z "$bun_bin" ]]; then
    bun_bin=$(command -v bun 2>/dev/null || true)
  fi
  [[ -n "$bun_bin" ]] || {
    echo "dot-tui binary missing and Bun required to build it is not installed." >&2
    echo "Run the official bootstrap script (installs everything needed):" >&2
    echo "  curl -fsSL https://raw.githubusercontent.com/agustinzamar/dotfiles/main/remote-install.sh | bash" >&2
    return 1
  }

  required=$(<"$DOTFILES_DIR/.bun-version")
  installed=$("$bun_bin" --version 2>/dev/null) || return 1
  if ! version_at_least "$installed" "$required"; then
    echo "dot-tui binary missing and Bun >= $required not found (found $installed)." >&2
    echo "Run the official bootstrap script (installs everything needed):" >&2
    echo "  curl -fsSL https://raw.githubusercontent.com/agustinzamar/dotfiles/main/remote-install.sh | bash" >&2
    return 1
  fi
  echo "==> Building dot-tui (one-time)" >&2
  (
    cd "$DOTFILES_DIR/tools/tui" &&
      "$bun_bin" install --frozen-lockfile &&
      "$bun_bin" build --compile --minify src/main.ts --outfile "$bin"
  ) || {
    echo "dot-tui build failed." >&2
    return 1
  }
  printf '%s\n' "$bin"
}

sub_baseline() {
  log "Installing baseline tools"
  run_step "Core command-line tools" installed brew install go zsh fzf git gh lazygit hunk tmux yazi neovim
  run_step "Ghostty" installed brew install --cask ghostty
  sub_zsh
  sub_git
}

# dot ai [agent...] [--skills|--plugins]
#
# Opt-in: no install phase calls this. Named agents win; otherwise every agent
# whose CLI is on this machine gets its share of the manifests. Neither flag
# runs both kinds. All named agents share one pass per kind, so the skills CLI
# runs once per entry with a comma-joined --agent set.
sub_ai() {
  local do_skills=false do_plugins=false agents=() arg failures=()
  for arg in "$@"; do
    case "$arg" in
      --skills) do_skills=true ;;
      --plugins) do_plugins=true ;;
      -*)
        echo "Usage: dot ai [$(ai_agent_names)] [--skills|--plugins]" >&2
        return 1
        ;;
      *)
        ai_agent_cli "$arg" >/dev/null || {
          echo "unknown agent: $arg — try: $(ai_agent_names)" >&2
          return 1
        }
        agents+=("$arg")
        ;;
    esac
  done
  $do_skills || $do_plugins || {
    do_skills=true
    do_plugins=true
  }
  ((${#agents[@]})) || read -ra agents <<<"$(ai_agent_names)"

  if $do_skills; then ai_install skills "${agents[@]}" || failures+=("skills"); fi
  if $do_plugins; then ai_install plugins "${agents[@]}" || failures+=("plugins"); fi

  if ((${#failures[@]})); then
    echo "❌ Finished with failures: ${failures[*]}" >&2
    return 1
  fi
  return 0
}

sub_full() {
  log "Full install"
  local phase failures=()
  for phase in bootstrap brew link zsh code macos duti git; do
    "sub_$phase" || failures+=("$phase")
  done

  if ((${#failures[@]})); then
    echo "❌ Finished with failures: ${failures[*]}" >&2
    return 1
  fi
  log "Installation complete"
}

# Installs a topic by name from install/topics/<name>.
install_topic() {
  local name="$1"
  local core="$TOPIC_DIR/$name"
  if [[ -f "$core" ]]; then
    run_topic_file "$name" "$core"
    return 0
  fi
  echo "no such topic: $name" >&2
  return 1
}

sub_bootstrap() {
  log "Bootstrap: Xcode CLT + Homebrew (idempotent)"

  # Known-path checks, never PATH-dependent: a GUI-launched terminal on macOS
  # starts with /usr/bin:/bin:/usr/sbin:/sbin, so `type brew`/`xcode-select`
  # can miss installs that are actually present and trigger a reinstall.
  local xc=/usr/bin/xcode-select brew_bin=""
  for candidate in /opt/homebrew/bin/brew /usr/local/bin/brew; do
    [[ -x "$candidate" ]] && brew_bin=$candidate
  done

  if "$xc" -p >/dev/null 2>&1; then
    echo '✅ Xcode already installed'
  elif "$DRY_RUN"; then
    echo '+ install Xcode CLT'
  else
    run "$xc" --install
  fi

  if [[ -n "$brew_bin" ]]; then
    echo "✅ Homebrew already installed ($brew_bin)"
  elif "$DRY_RUN"; then
    echo '+ install Homebrew'
  else
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    brew_bin=/opt/homebrew/bin/brew
    [[ -x "$brew_bin" ]] || brew_bin=/usr/local/bin/brew
  fi
}

sub_brew() {
  log "Installing Homebrew packages"
  local topic failures=()
  while read -r topic; do
    # `code` and `duti` live in topics/ but are plain lists, not Brewfiles:
    # sub_code and sub_duti read them, and `brew bundle` chokes on both. A
    # topic with its own installer is not this loop's business.
    declare -F "sub_$topic" >/dev/null && continue
    run_topic_file "$topic" "$TOPIC_DIR/$topic" || failures+=("$topic")
  done < <(topics)

  if ((${#failures[@]})); then
    log "topics that failed: ${failures[*]}"
    return 1
  fi
}

sub_zsh() {
  log "Setting up Zsh"

  # .zshrc only sources zinit; installing it from an interactive shell would
  # mean cloning from GitHub before the prompt can be drawn.
  local zinit_home="${XDG_DATA_HOME:-$HOME/.local/share}/zinit/zinit.git"
  if [[ -r "$zinit_home/zinit.zsh" ]]; then
    echo '✅ zinit already installed'
  else
    run mkdir -p "$(dirname "$zinit_home")"
    run git clone --depth=1 https://github.com/zdharma-continuum/zinit.git "$zinit_home"
  fi

  # Handle fzf post install script
  local brew_prefix
  brew_prefix=$(brew --prefix 2>/dev/null || true)
  if [[ -n "$brew_prefix" && -x "$brew_prefix/opt/fzf/install" ]]; then
    # --no-update-rc: --all would otherwise append a source line to ~/.zshrc,
    # which is a symlink into this repo, so the installer edits a tracked file
    # on every run. .zshrc sources ~/.fzf.zsh instead.
    run_step "fzf key bindings" installed "$brew_prefix/opt/fzf/install" --all --no-update-rc --no-bash --no-fish
  fi
}

sub_code() {
  if is_executable code; then
    log "Installing VS Code extensions"
    local installed extension present added
    present=0
    added=0
    installed=$(code --list-extensions 2>/dev/null | tr '[:upper:]' '[:lower:]')
    while read -r extension; do
      if grep -qxF "$(tr '[:upper:]' '[:lower:]' <<<"$extension")" <<<"$installed"; then
        present=$((present + 1))
        continue
      fi
      echo "-- $extension"
      run code --install-extension "$extension"
      added=$((added + 1))
    done < <(read_package_file "$DOTFILES_DIR/install/topics/code")
    # Without this the step prints a heading and nothing else on a machine that
    # already has every extension, which reads like it did no work.
    echo "$present already installed, $added added"
  else
    echo "⚠️ VS Code not installed; skipping extension setup" >&2
  fi
}

sub_duti() {
  if is_executable duti; then
    log "Setting default apps for file types"
    run duti -v "$DOTFILES_DIR/install/topics/duti" 2>&1 | grep -v "error -50" || true
  else
    echo "⚠️ duti not installed; skipping default app setup" >&2
  fi
}

sub_git() {
  log "Configuring git"
  install_git

  # `|| continue` rather than `&&`: as a function body under `set -e`, a final
  # falsy test would abort the whole install run.
  for key in "$HOME"/.ssh/id_*; do
    case "$key" in *.pub | *.revoked) continue ;; esac
    [[ -f "$key" ]] || continue
    run ssh-add --apple-use-keychain "$key"
  done
}

sub_link() {
  local target="${1:-}"
  shift 2>/dev/null || true
  case "$target" in
    "")
      log "Linking dotfiles"
      link_all
      ;;
    all | --all)
      LINK_FORCE=true link_all
      ;;
    help)
      echo "Usage: $BIN_NAME link [target]"
      echo "   (no target)  Symlink every config into place"
      echo "   <name>       Symlink one config: $(link_names)"
      echo "   opt-in only  $(optional_link_names) — skipped by a bare \`link\`"
      ;;
    *)
      LINK_FORCE=true link_named "$target"
      ;;
  esac
}

# True when version $1 is at least version $2 (dot-separated numbers).
version_at_least() {
  [[ $(printf '%s\n' "$1" "$2" | sort -V | head -n1) == "$2" ]]
}

# Launch the dot-tui installer binary in the documented resolution order
# (dot-cli-bootstrap spec):
#   1. a prebuilt/local binary at bin/dot-tui — needs neither Go nor Bun;
#   2. Bun >= the .bun-version pin: build the binary from source, then run it;
#   3. otherwise print actionable bootstrap guidance and fail loudly.
# resolve_dot_tui echoes the resolved binary path (or fails loudly);
# run_dot_tui launches it and returns its exit code so callers can map the
# 0/10/error contract (never exec: the caller still owns the temp context
# file and the exit-code mapping).
resolve_dot_tui() {
  # Single resolver (PATH-independent; see dot_runtime_path). Headless
  # --profile builds use the same prebuilt-or-build lookup as interactive.
  dot_runtime_path
}

run_dot_tui() {
  local bin
  bin=$(resolve_dot_tui) || return 1
  "$bin" "$@"
}

# Headless profile install: same context JSON the interactive path emits
# (the TUI refuses to run without it) plus -apply -profile. No TTY guard —
# scripts and CI never have one, and the TUI's apply mode mounts no UI.
run_profile_install() {
  local profile="$1"
  local ctx exit_code=0
  ctx=$(mktemp) || return 1
  install_context_json "$ctx" || {
    rm -f "$ctx"
    return 1
  }
  local args=(-apply -profile "$profile" --context "$ctx")
  "$DRY_RUN" && args+=(--dry-run)
  run_dot_tui "${args[@]}" || exit_code=$?
  rm -f "$ctx"
  return "$exit_code"
}

sub_unlink() {
  log "Removing symlinks"
  unlink_all
}

sub_macos() {
  apply_defaults "$DOTFILES_DIR/system/defaults/macos.sh"
  echo "Some changes may require a logout or restart to take effect."
}

sub_dock() {
  apply_defaults "$DOTFILES_DIR/system/defaults/dock.sh"
}

sub_doctor() {
  local failed=0 command
  check() {
    command -v "$1" >/dev/null 2>&1 || {
      echo "missing: $1"
      failed=1
    }
  }
  # Takes the same (source, target, mode) a link map row carries, so the whole
  # map can be walked instead of a hand-kept subset that goes stale.
  # shellcheck disable=SC2329  # called by name from _walk_links
  check_link() {
    local source=$1 target=$2 mode=${3:-}
    # An app-writable target is a live file on purpose, never a symlink.
    [[ "$mode" == app-writable ]] && return 0
    [[ -L "$target" && "$(readlink "$target")" == "$DOTFILES_DIR/$source" ]] || {
      echo "broken: $target"
      failed=1
    }
  }

  # jq reads the ai/ manifests; without it `dot ai` cannot run at all.
  for command in brew git jq; do check "$command"; done
  is_executable dot || {
    echo "not on PATH: dot (run \`dot link\` then restart your shell; the repo must live at ~/dotfiles)"
    failed=1
  }
  # Opt-in links stay out of this: not having them is a choice, not a fault.
  _walk_links all_links check_link
  if ((failed == 0)); then echo "dotfiles: healthy"; fi
  return "$failed"
}

sub_update() {
  run git -C "$DOTFILES_DIR" pull
  # A pull can add a row to the link map; linking is idempotent, so re-run it
  # here rather than leaving the new config unlinked until the next install.
  sub_link
  if is_executable topgrade; then
    run topgrade
  else
    run brew update
    run brew upgrade
  fi
}

sub_backup() {
  local untracked
  if [[ -z "$(git -C "$DOTFILES_DIR" status --porcelain)" ]]; then
    echo "No changes to commit."
    return 0
  fi

  # Tracked changes only. This repo is public, so a stray file in the working
  # tree must be added on purpose, not swept in by a backup command.
  untracked=$(git -C "$DOTFILES_DIR" ls-files --others --exclude-standard)
  if [[ -n "$untracked" ]]; then
    printf '\nNot committed, untracked — add them yourself if you want them:\n%s\n' "$untracked" >&2
  fi

  if git -C "$DOTFILES_DIR" diff --quiet && git -C "$DOTFILES_DIR" diff --cached --quiet; then
    echo "Nothing tracked to commit."
    return 0
  fi
  run git -C "$DOTFILES_DIR" add -u
  run git -C "$DOTFILES_DIR" commit -m "backup: $(date '+%Y-%m-%d %H:%M')"
  run git -C "$DOTFILES_DIR" push
}

sub_clean() {
  if is_executable mole; then
    if ! "$DRY_RUN" && ! sudo -n true 2>/dev/null; then
      printf '\n==> 🔒 Requesting administrator access\n'
      if ! sudo -v; then
        echo '❌ Administrator access failed' >&2
        return 1
      fi
    fi

    # run_step captures output, so Mole's terminal sudo prompt would be
    # invisible and wait forever. Close stdin after the initial sudo prompt.
    run_step "Mole cleanup" complete mole clean </dev/null || return 1
  fi
  run_step "Homebrew cleanup" complete brew cleanup
  if is_executable pnpm; then run_step "pnpm store cleanup" complete pnpm store prune; fi
}

sub_edit() {
  sh -c "${VISUAL:-code} $DOTFILES_DIR"
}

sub_test() {
  bats "$DOTFILES_DIR"/test/*.bats
}

TOP_COMMANDS=" backup clean doctor edit help install link test unlink update "

COMMAND_NAME=${1:-}
case "$COMMAND_NAME" in
  "" | -h | --help | help)
    sub_help
    ;;
  # Hidden: the TUI runs `dot bootstrap` as the first step of its apply phase
  # so Xcode CLT + Homebrew are installed only after the user confirms a
  # selection (never before the selector appears). Intentionally not in
  # TOP_COMMANDS / help.
  bootstrap)
    shift
    sub_bootstrap "$@"
    ;;
  *)
    shift
    if [[ "$TOP_COMMANDS" == *" $COMMAND_NAME "* ]]; then
      "sub_${COMMAND_NAME//-/_}" "$@"
    elif resolve_install_target "$COMMAND_NAME" >/dev/null; then
      sub_install "$COMMAND_NAME" "$@"
    else
      echo "'$COMMAND_NAME' is not a known command." >&2
      sub_help >&2
      exit 1
    fi
    ;;
esac
