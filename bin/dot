#!/usr/bin/env bash
# shellcheck source-path=SCRIPTDIR
set -Eeuo pipefail

BIN_NAME=$(basename "$0")
# `pwd -P`, so that invoking dot through the ~/.dotfiles symlink resolves to
# the same path `link` wrote into the symlinks. Otherwise doctor calls every
# link broken and unlink declines to remove them.
DOTFILES_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
export DOTFILES_DIR

# --dry-run is global: pull it out before working out which subcommand ran.
DRY_RUN=false
args=()
for arg in "$@"; do
  case "$arg" in
    --dry-run) DRY_RUN=true ;;
    *) args+=("$arg") ;;
  esac
done
export DRY_RUN
set -- ${args[@]+"${args[@]}"}

# shellcheck source=../install/common.sh
. "$DOTFILES_DIR/install/common.sh"
# shellcheck source=../install/links.sh
. "$DOTFILES_DIR/install/links.sh"
# shellcheck source=../install/zsh.sh
. "$DOTFILES_DIR/install/zsh.sh"
# shellcheck source=../install/git.sh
. "$DOTFILES_DIR/install/git.sh"
# shellcheck source=../install/tools.sh
. "$DOTFILES_DIR/install/tools.sh"

sub_help() {
  echo "Usage: $BIN_NAME <command> [--dry-run]"
  echo
  echo "Commands:"
  echo "   backup           Commit and push this repo"
  echo "   clean            Clean up caches"
  echo "   doctor           Check that required tools and symlinks are in place"
  echo "   edit             Open dotfiles in \$VISUAL"
  echo "   help             This help message"
  echo "   migrate-custom   Move ~/.dotfiles-custom files to ~/.dotfiles-home/custom"
  echo "   test             Run tests"
  echo "   unlink           Remove symlinks that point into this repo"
  echo "   update           Pull, upgrade packages, then re-run the install"
  echo
  echo "Install:"
  echo "   install              Bootstrap: link configs + install zinit"
  echo "   install --minimal   Bootstrap + brew + core + dev + git"
  echo "   install --laravel   Minimal + herd + dbngin"
  echo "   install links        Symlink shell configs only"
  echo "   install zsh          Install zinit plugin manager"
  echo "   install brew         Install Homebrew + all topics"
  echo "   install ai              Sync skills + plugins to all AI tools"
  echo "   install ai claude       Skills + plugins to Claude only"
  echo "   install ai codex        Skills + plugins to Codex only"
  echo "   install ai opencode     Skills + plugins to OpenCode only"
  echo "   install ai <tool> --skills   Skills only"
  echo "   install ai <tool> --plugins  Plugins only"
  echo "   install tools        Install tools Homebrew Bundle does not cover"
  echo "   install code         Install VS Code extensions"
  echo "   install git          Set git config (skips name/email/gpg)"
  echo "   install macos        Apply macOS system defaults"
  echo "   install dock         Apply macOS Dock settings"
  echo "   install duti         Set default apps for file types"
  echo "   install --full       Install everything"
  local topic
  echo
  echo "Topics (installed by \`brew\`, or one at a time):"
  while read -r topic; do
    printf '   %-16s %s\n' "$topic" "$(head -1 "$(topic_path "$topic")" | sed 's/^# *//')"
  done < <(topics)
  echo
  echo "Optional topics (only when asked for by name):"
  while read -r topic; do
    printf '   %-16s %s\n' "$topic" "$(head -1 "$(topic_path "$topic")" | sed 's/^# *//')"
  done < <(optional_topics)
}

# One broken package should not cost you the symlinks: run every phase, then
# report. Exits non-zero so CI and `make install` still fail loudly.
sub_install() {
  local cmd="${1:-}"
  shift 2>/dev/null || true

  case "$cmd" in
    --full | -f)
      sub_full
      return $?
      ;;
    --minimal | -m)
      log "Minimal setup"
      local phase failures=()
      for phase in link zsh brew; do
        "sub_$phase" || failures+=("$phase")
      done
      # Install core + dev topics only
      for topic in core dev; do
        install_topic "$topic" || true
      done
      sub_git
      if ((${#failures[@]})); then
        log "Finished with failures: ${failures[*]}"
        return 1
      fi
      log "Minimal complete — run \`dot install --full\` for everything"
      return 0
      ;;
    --laravel | -l)
      # minimal + herd + dbngin (herd bundles PHP, composer, etc.)
      sub_install --minimal
      log "Installing Laravel tools"
      run brew install --cask herd dbngin
      return 0
      ;;
    ai)
      sub_install_ai "$@"
      return $?
      ;;
    apps)
      return $?
      ;;
    "" | bootstrap)
      log "Bootstrapping dotfiles"
      local phase failures=()
      for phase in link zsh; do
        "sub_$phase" || failures+=("$phase")
      done
      if ((${#failures[@]})); then
        log "Finished with failures: ${failures[*]}"
        return 1
      fi
      log "Bootstrap complete — run \`dot install --minimal\` for tools and dev packages"
      return 0
      ;;
    *)
      local sub
      case "$cmd" in
        links) sub=sub_link_shell ;;
        *) sub="sub_$cmd" ;;
      esac
      if declare -F "$sub" >/dev/null; then
        "$sub"
      elif topic_path "$cmd" >/dev/null; then
        install_topic "$cmd"
      else
        echo "'$cmd' is not an install command or topic." >&2
        return 1
      fi
      ;;
  esac
}

sub_install_apps() {
  local items=() item topic
  local dirs=("$TOPIC_DIR" "$TOPIC_DIR/optional")
  local f name dir
  for dir in "${dirs[@]}"; do
    for f in "$dir"/*; do
      [[ -f "$f" ]] || continue
      topic=$(basename "$f")
      [[ "$dir" == "$TOPIC_DIR/optional" ]] && topic="optional/$topic"
      while IFS=' ' read -r type rest; do
        [[ -z "$rest" ]] && continue
        name=${rest#\"}
        name=${name%\"}
        items+=("$name|$type|$topic")
      done < <(grep -E '^(brew|cask|mas) "' "$f" 2>/dev/null)
    done
  done

  if ((${#items[@]} == 0)); then
    echo "No packages found."
    return 0
  fi

  if is_executable fzf; then
    local selected
    selected=$(printf '%s\n' "${items[@]}" |
      fzf --multi --prompt="Select packages to install > " \
        --with-nth=1 --delimiter='|' \
        --preview 'echo "topic: {3} | type: {2}"' \
        --bind 'ctrl-a:select-all,ctrl-d:deselect-all')
    [[ -z "$selected" ]] && return 0
    while IFS='|' read -r pkg type _; do
      case "$type" in
        cask) run brew install --cask "$pkg" ;;
        mas) run mas install "$pkg" ;;
        brew) run brew install "$pkg" ;;
      esac
    done <<<"$selected"
  else
    echo "Available packages:"
    local names=()
    for item in "${items[@]}"; do
      names+=("${item%%|*}")
    done
    select name in "${names[@]}" "done"; do
      [[ "$name" == "done" ]] && break
      [[ -n "$name" ]] && run brew install "$name" || true
    done
  fi
}

sub_install_ai() {
  _install_skills() {
    local tool="$1"
    local IFS='|' dir
    for dir in $link_dirs; do
      [[ -L "$dir" && ! -e "$dir" ]] && run rm "$dir"
    done

    local manifest="$DOTFILES_DIR/ai/skills.json"
    if [[ -f "$manifest" ]]; then
      local source skill
      while IFS=$'\t' read -r source skill; do
        [[ -z "$source" ]] && continue
        if [[ -z "$skill" || "$skill" == "null" ]]; then
          log "Installing skill [$tool]: $source"
          run npx skills add "$source" --agent "$agent" -y
        else
          log "Installing skill [$tool]: $source/$skill"
          run npx skills add "$source" --agent "$agent" --skill "$skill" -y
        fi
      done < <(jq -r '.skills[] | [.source, (.skill // null)] | @tsv' "$manifest" 2>/dev/null)
    fi
    # Link any local/custom skills not on skills.sh, scoped to this tool's dir(s).
    [[ -d "$DOTFILES_DIR/ai/skills" && "$(ls -A "$DOTFILES_DIR/ai/skills" 2>/dev/null)" ]] || return 0
    for dir in $link_dirs; do
      link_file "ai/skills" "$dir"
    done
  }

  _install_plugins() {
    local manifest="$DOTFILES_DIR/ai/plugins.json"
    [[ -f "$manifest" ]] || return 0

    _install_cli_plugins() {
      local tool="$1" cli="$2" label="$3"
      if ! is_executable "$cli"; then
        echo "$label CLI not found; skipping plugins" >&2
        return 0
      fi

      local name repo marketplace_name marketplace_source plugin marketplaces
      while IFS='|' read -r name repo marketplace_name marketplace_source plugin; do
        [[ -n "$plugin" ]] || continue
        log "Plugin [$tool]: $name ($repo)"
        if [[ -n "$marketplace_source" ]]; then
          if "$DRY_RUN"; then
            run "$cli" plugin marketplace add "$marketplace_source" || return
          else
            marketplaces=$("$cli" plugin marketplace list --json) || return
            jq -e --arg name "$marketplace_name" '.. | strings | select(. == $name)' \
              <<<"$marketplaces" >/dev/null || run "$cli" plugin marketplace add "$marketplace_source" || return
          fi
        fi
        case "$tool" in
          claude-code) run "$cli" plugin install --scope user "$plugin" || return ;;
          codex) run "$cli" plugin add "$plugin" || return ;;
        esac
      done < <(jq -r --arg tool "$tool" '.plugins[] | select(.install[$tool].plugin) |
        [.name, .repo, (.install[$tool].marketplace.name // ""),
         (.install[$tool].marketplace.source // ""), .install[$tool].plugin] | join("|")' "$manifest")
    }

    case "$agent" in
      claude-code) _install_cli_plugins claude-code claude "Claude Code" ;;
      codex) _install_cli_plugins codex codex Codex ;;
      opencode) log "No OpenCode V2-compatible plugins configured" ;;
      '*')
        _install_cli_plugins claude-code claude "Claude Code" || return
        _install_cli_plugins codex codex Codex || return
        log "No OpenCode V2-compatible plugins configured"
        ;;
    esac
  }

  # Parse the tool and any --skills/--plugins flags. With neither flag, both run.
  local target="${1:-all}"
  shift 2>/dev/null || true
  [[ "$target" == "--"* ]] && {
    set -- "$target" "$@"
    target=all
  }
  local agent link_dirs
  case "$target" in
    all)
      agent='*'
      link_dirs="$HOME/.claude/skills|$HOME/.agents/skills"
      ;;
    claude)
      agent=claude-code
      link_dirs="$HOME/.claude/skills"
      ;;
    codex | opencode)
      agent="$target"
      link_dirs="$HOME/.agents/skills"
      ;;
    --skills | --plugins)
      set -- "$target" "$@"
      target=all
      ;;
    *)
      echo "Usage: dot install ai [all|claude|codex|opencode] [--skills|--plugins]" >&2
      return 1
      ;;
  esac

  local do_skills=false do_plugins=false arg
  for arg in "$@"; do
    case "$arg" in
      --skills) do_skills=true ;;
      --plugins) do_plugins=true ;;
      *)
        echo "unknown flag: $arg" >&2
        return 1
        ;;
    esac
  done
  # No flags = both, matching "dot install ai" = All.
  $do_skills || $do_plugins || {
    do_skills=true
    do_plugins=true
  }

  $do_skills && _install_skills "$target"
  if $do_plugins; then
    _install_plugins "$target" || return
  fi
  return 0
}

sub_full() {
  log "Full install"
  local phase failures=()
  for phase in brew link zsh tools code macos duti git; do
    "sub_$phase" || failures+=("$phase")
  done

  if ((${#failures[@]})); then
    log "Finished with failures: ${failures[*]}"
    return 1
  fi
  log "Installation complete"
}

# Every file under install/topics/ is a Brewfile and a command: `dot media`
# installs install/topics/media. Adding a topic is adding one file.
#
# Files directly in topics/ are installed by `dot brew`; those in
# topics/optional/ are not, so a machine opts into them by name. Moving a topic
# between the two is a `git mv`.
TOPIC_DIR="$DOTFILES_DIR/install/topics"

# `return 0` because a glob that ends on a non-file would otherwise leave the
# function's status non-zero, which `set -e` treats as a failure.
_topic_names() {
  local file
  for file in "$1"/*; do
    [[ -f "$file" ]] && basename "$file"
  done
  return 0
}

topics() { _topic_names "$TOPIC_DIR"; }
optional_topics() { _topic_names "$TOPIC_DIR/optional"; }

topic_path() {
  local dir
  for dir in "$TOPIC_DIR" "$TOPIC_DIR/optional"; do
    [[ -f "$dir/$1" ]] && {
      printf '%s' "$dir/$1"
      return 0
    }
  done
  return 1
}

install_topic() {
  local path
  path=$(topic_path "$1") || {
    echo "no such topic: $1" >&2
    return 1
  }
  log "Installing $1"
  run brew bundle --file="$path"
}

sub_brew() {
  log "Installing Homebrew"
  if is_executable brew; then
    :
  elif "$DRY_RUN"; then
    echo '+ install Homebrew'
  else
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  fi

  local topic failures=()
  while read -r topic; do
    install_topic "$topic" || failures+=("$topic")
  done < <(topics)

  if ((${#failures[@]})); then
    echo "topics that failed: ${failures[*]}" >&2
    return 1
  fi
}

# The package files are plain lists: one name per line, `#` comments and blank
# lines ignored. Keeping them as data means adding a package is a one-line diff.
read_package_file() {
  sed -e 's/#.*//' -e 's/[[:space:]]*$//' "$1" | grep -v '^$' || true
}

sub_code() {
  is_executable code || return 0
  log "Installing VS Code extensions"
  local installed extension
  installed=$(code --list-extensions 2>/dev/null | tr '[:upper:]' '[:lower:]')
  while read -r extension; do
    grep -qxF "$(tr '[:upper:]' '[:lower:]' <<<"$extension")" <<<"$installed" ||
      run code --install-extension "$extension"
  done < <(read_package_file "$DOTFILES_DIR/install/Codefile")
}

sub_duti() {
  is_executable duti || return 0
  log "Setting default apps for file types"
  run duti -v "$DOTFILES_DIR/install/duti" 2>&1 | grep -v "error -50" || true
}

sub_git() {
  log "Configuring git"
  install_git
}

sub_link() {
  log "Linking dotfiles"
  link_all
}

sub_link_shell() {
  log "Linking shell dotfiles"
  link_shell
}

sub_unlink() {
  log "Removing symlinks"
  unlink_all
}

sub_zsh() {
  log "Setting up Zsh"
  install_zsh
}

sub_migrate_custom() {
  log "Migrating custom configs"
  migrate_zsh_custom
}

sub_tools() {
  log "Installing extra tools"
  install_tools
}

# `_defaults.sh` sorts first, which is what the underscore is for: the shared
# system settings land before the per-app ones.
#
# These scripts call `defaults write` directly rather than going through `run`,
# so --dry-run has to stop short of sourcing them or it would apply the lot.
apply_defaults() {
  local file
  for file in "$@"; do
    [[ -f "$file" ]] || continue
    log "Applying ${file#"$DOTFILES_DIR"/}"
    if "$DRY_RUN"; then
      echo "+ source ${file#"$DOTFILES_DIR"/}"
    else
      # shellcheck source=/dev/null
      . "$file"
    fi
  done
}

sub_macos() {
  apply_defaults "$DOTFILES_DIR"/system/macos/*defaults.sh
  echo "Some changes may require a logout or restart to take effect."
}

sub_dock() {
  apply_defaults "$DOTFILES_DIR/system/macos/dock-defaults.sh"
}

sub_doctor() {
  local failed=0 command
  check() {
    command -v "$1" >/dev/null 2>&1 || {
      echo "missing: $1"
      failed=1
    }
  }
  check_link() {
    [[ -L "$2" && "$(readlink "$2")" == "$DOTFILES_DIR/$1" ]] || {
      echo "broken: $2"
      failed=1
    }
  }

  for command in brew git zsh; do check "$command"; done
  # Catches system/.exports not being linked, or the shell not having been
  # restarted since it was.
  is_executable dot || {
    echo "not on PATH: dot (link system/.exports, then restart your shell)"
    failed=1
  }
  check_link config/zsh/.zshrc "$HOME/.zshrc"
  check_link config/p10k/.p10k.zsh "$HOME/.p10k.zsh"
  check_link config/ghostty/config "$HOME/.config/ghostty/config"
  check_link config/tmux/tmux.conf "$HOME/.config/tmux/tmux.conf"
  # git config is set via install/git.sh, not symlinked — skip check
  if ((failed == 0)); then echo "dotfiles: healthy"; fi
  return "$failed"
}

sub_update() {
  run git -C "$DOTFILES_DIR" pull
  if is_executable topgrade; then
    run topgrade
  else
    run brew update
    run brew upgrade
  fi
  sub_full
}

sub_backup() {
  if [[ -z "$(git -C "$DOTFILES_DIR" status --porcelain)" ]]; then
    echo "No changes to commit."
    return 0
  fi
  run git -C "$DOTFILES_DIR" add -A
  run git -C "$DOTFILES_DIR" commit -m "backup: $(date '+%Y-%m-%d %H:%M')"
  run git -C "$DOTFILES_DIR" push
}

sub_clean() {
  if is_executable mole; then run mole clean; fi
  run brew cleanup
  if is_executable npm; then run npm cache clean --force; fi
}

sub_edit() {
  sh -c "${VISUAL:-code} $DOTFILES_DIR"
}

sub_test() {
  bats "$DOTFILES_DIR"/test/*.bats
}

TOP_COMMANDS=" backup clean doctor edit help install migrate-custom test unlink update "

COMMAND_NAME=${1:-}
case "$COMMAND_NAME" in
  "" | -h | --help | help)
    sub_help
    ;;
  *)
    shift
    if [[ "$TOP_COMMANDS" == *" $COMMAND_NAME "* ]]; then
      "sub_${COMMAND_NAME//-/_}" "$@"
    else
      echo "'$COMMAND_NAME' is not a known command." >&2
      sub_help >&2
      exit 1
    fi
    ;;
esac
