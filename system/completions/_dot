#compdef dot
# Completion for `dot`, generated from `dot help` so that adding a command or
# a topic needs no change here.

_dot() {
  local -a subcommands
  # `   cmd  desc` has two or more spaces between cmd and desc; sub-arg forms
  # like `   link zsh  desc` or `   install <topic>  desc` have only one,
  # which is what we want to skip here.
  subcommands=(${(f)"$(_call_program dot-help dot help 2>/dev/null |
    sed -n 's/^   \([a-z][a-z0-9-]*\)   *\(.*\)$/\1:\2/p')"})

  _arguments -C \
    '--dry-run[print what would run, touching nothing]' \
    '1:command:->command' \
    '*::arg:->args'

  case $state in
    command) _describe -t commands 'dot command' subcommands ;;
  esac
}

_dot "$@"
