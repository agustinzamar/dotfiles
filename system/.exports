# Lang
export LANG=en_US.UTF-8

# Homebrew
export PATH="/opt/homebrew/sbin:$PATH"
export PATH="/opt/homebrew/bin:$PATH"

# This repo's own CLI (dot, is-*). .zshrc exports DOTFILES_DIR from its own
# resolved path before sourcing this; the default covers any other caller.
export PATH="${DOTFILES_DIR:-$HOME/dotfiles}/bin:$PATH"

# pnpm lives in system/env/10-path.zsh.

# pipx
export PATH="$PATH:$HOME/.local/bin"

# DBngin MySQL (auto-finds current version directory)
if [[ -d "/Users/Shared/DBngin/mysql" ]]; then
  for dir in /Users/Shared/DBngin/mysql/*/bin(N); do
    export PATH="$dir:$PATH"
  done
fi

