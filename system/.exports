# App-specific exports, sourced by .zshrc after the basic shell environment.
# Basic env (LANG, Homebrew, dotfiles bin, pipx) lives inline in .zshrc.
# Each block applies only when the tool is installed, so PATH and env stay
# clean on machines without it.

# MySQL client
[[ -d "/opt/homebrew/opt/mysql-client/bin" ]] &&
  export PATH="/opt/homebrew/opt/mysql-client/bin:$PATH"

# Ghostty CLI (use `ghostty +list-fonts`, `+show-config`, etc.)
[[ -d "/Applications/Ghostty.app/Contents/MacOS" ]] &&
  export PATH="/Applications/Ghostty.app/Contents/MacOS:$PATH"

# pnpm global bin
if [[ -d "$HOME/Library/pnpm" ]]; then
  export PNPM_HOME="$HOME/Library/pnpm"
  export PATH="$PNPM_HOME/bin:$PNPM_HOME:$PATH"
fi

# Composer's global bin holds `valet`, installed with
# `composer global require laravel/valet`. Homebrew's php 8.5 is the default CLI;
# the other PHP versions stay keg-only and Valet switches them per site.
COMPOSER_GLOBAL_BIN="$HOME/.composer/vendor/bin"
[[ -d "$COMPOSER_GLOBAL_BIN" ]] && export PATH="$COMPOSER_GLOBAL_BIN:$PATH"

# mise: pinned global runtimes from config/mise/config.toml, plus per-project
# switching driven by the .nvmrc files under ~/Repositories/.
if command -v mise &>/dev/null; then
  eval "$(mise activate zsh)"
fi

# Direnv
if command -v direnv &>/dev/null; then
  eval "$(direnv hook zsh)"
fi