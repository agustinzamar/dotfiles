{
  "plugins": [
    {
      "name": "ponytail",
      "repo": "DietrichGebert/ponytail",
      "homepage": "https://github.com/DietrichGebert/ponytail",
      "install": {
        "claude-code": "claude plugin marketplace add DietrichGebert/ponytail && claude plugin install ponytail@ponytail",
        "codex": "codex plugin marketplace add DietrichGebert/ponytail && codex plugin install ponytail@ponytail",
        "opencode": "@dietrichgebert/ponytail"
      }
    },
    {
      "name": "superpowers",
      "repo": "obra/superpowers",
      "homepage": "https://github.com/obra/superpowers",
      "install": {
        "claude-code": "claude plugin install superpowers@claude-plugins-official",
        "codex": "codex plugin install superpowers@openai-curated",
        "opencode": "superpowers@git+https://github.com/obra/superpowers.git"
      }
    }
  ]
}